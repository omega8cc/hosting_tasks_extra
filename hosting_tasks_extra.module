/**
 * Implements hook_hosting_tasks().
 */
function hosting_tasks_extra_hosting_tasks() {
  $tasks = array();

  $tasks['site']['flush_cache'] = array(
    'title' => t('Flush all caches'),
    'access callback' => 'hosting_tasks_extra_flush_cache_task_access',
    'description' => t('Flushes all caches on this site. This may cause a short load peak on any busy site, so please run it only if you have a good reason to flush caches on demand instead of allowing the site cron to flush them, when scheduled.'),
    'dialog' => TRUE,
  );

  $tasks['site']['rebuild_registry'] = array(
    'title' => t('Rebuild registry'),
    'access callback' => 'hosting_tasks_extra_rebuild_registry_task_access',
    'description' => t('Rebuilds the registry (Drupal 6/7) or the service container (Drupal 8+) and flushes all caches on this site. On Drupal 7 it recreates the registry tables from scratch; on Drupal 8+ it rebuilds the compiled service container and flushes every cache (drush cr). This may cause a short load peak on any busy site, so please run it only if you have a good reason to rebuild.'),
    'dialog' => TRUE,
  );

  $tasks['site']['utf8mb4_convert'] = array(
    'title' => t('Convert to utf8mb4'),
    'description' => t('Converts this Drupal 7 site database from 3-byte utf8 to utf8mb4 (full Unicode, collation utf8mb4_unicode_ci). Made for sites imported from older servers; databases created on this server are utf8mb4 already, and for them this task simply reports that there is nothing to convert. A fresh backup is taken first, and the site stays in maintenance mode while its tables are converted and comes back online once the result is verified. On a large database this can take several minutes. The safe workflow is to clone the site, convert the clone, inspect it, and only then convert the original or keep the converted clone.'),
    'dialog' => TRUE,
    'access callback' => 'hosting_tasks_extra_utf8mb4_convert_task_access',
  );

/*
  Removed to close potential attack vector.
    $tasks['site']['run_cron'] = array(
      'title' => t('Run drush cron'),
      'description' => t('Runs cron locally with drush on this site. It allows you to manually run the cron with longer timeout and higher memory allowed than in standard, web based, scheduled cron Ægir runs for you via cURL request to protected /cron.php URL.'),
      'dialog' => TRUE,
    );

  Removed because it should never be used in proper workflow, while exceptions should handled on command line
    $tasks['site']['update'] = array(
      'title' => t('Run db updates'),
      'description' => t('Runs database updates on this site -- but first it will create a hot-backup to be able to revert your site database to the pre-update state in case there will be any problem detected. NOTE: This task is NOT a replacement for proper upgrade workflow and should be used only occasionally.'),
      'dialog' => TRUE,
    );
 */

/*
  $tasks['site']['update_translations'] = array(
    'title' => t('Update translations'),
    'description' => t('Updates translations on this site.'),
    'dialog' => TRUE,
  );

  $tasks['site']['features_revert_all'] = array(
    'title' => t('Revert features'),
    'description' => t('Revert all Features modules overrides on this site.'),
    'dialog' => TRUE,
  );
  $tasks['site']['features_update_all'] = array(
    'title' => t('Update features'),
    'description' => t('Update all Features modules on this site: write overrides to files.'),
    'dialog' => TRUE,
  );

  $tasks['server']['flush_drush_cache'] = array(
    'title' => t('Flush Drush cache'),
    'description' => t('Flushes the Drush cache on this (web) server.'),
  );
 */

  $tasks['site']['updates_report'] = array(
    'title' => t('Check available updates'),
    'description' => hosting_tasks_extra_updates_report_text(),
    'dialog' => TRUE,
    'access callback' => 'hosting_tasks_extra_updates_report_task_access',
    // None: the confirm screen is this title and description.
    'parameters' => array(),
  );

  $tasks['site']['drupal_upgrade'] = array(
    'title' => t('Upgrade'),
    'description' => t('Move this site onto a newer version of its platform, keeping a copy to go back to.'),
    'command' => 'provision-drupal-upgrade',
    // It replaces the panel's own check, so it begins with it.
    'access callback' => 'hosting_tasks_extra_drupal_upgrade_task_access',
    'dialog' => TRUE,
    'parameters' => array('target_platform'),
  );

  $tasks['site']['drupal_upgrade_return'] = array(
    'title' => t('Go back'),
    'description' => t('Put back the copy of this site that its upgrade kept. The upgraded site is kept too, switched off.'),
    'command' => 'provision-drupal-upgrade-return',
    // It replaces the panel's own check, which hides every task but Enable
    // and Delete on a disabled site, where a run that stopped midway is
    // finished from: so it restates the rest of that check itself.
    'access callback' => 'hosting_tasks_extra_drupal_upgrade_return_task_access',
    'dialog' => TRUE,
    'parameters' => array(),
  );

  return $tasks;
}

/**
 * Is this site on a foreign-CMS (non-Drupal-lineage) platform?
 */
function hosting_tasks_extra_site_is_foreign_cms($node) {
  // Union-shaped, the same idiom as the hosting_cron guard: each foreign-CMS
  // frontend module contributes its predicate and the whole test is inert
  // where those modules are absent. Backdrop is deliberately NOT in the
  // union -- it runs the Drupal-shaped tasks and carries its own per-task
  // guards where they differ.
  if (empty($node->platform)) {
    return FALSE;
  }
  if (function_exists('hosting_grav_platform_is_grav')
    && hosting_grav_platform_is_grav($node->platform)) {
    return TRUE;
  }
  if (function_exists('hosting_txp_platform_is_txp')
    && hosting_txp_platform_is_txp($node->platform)) {
    return TRUE;
  }
  return FALSE;
}

/**
 * Access callback for the flush_cache task.
 *
 * Grav keeps the button: the backend routes it through grav clearcache.
 * Textpattern keeps no server-side cache at all, and the Drupal path would
 * clear only Drush's own cache while logging success -- hide it rather than
 * ship that.
 */
function hosting_tasks_extra_flush_cache_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  if (isset($node->platform) && function_exists('hosting_txp_platform_is_txp')
    && hosting_txp_platform_is_txp($node->platform)) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Access callback for the utf8mb4_convert task.
 *
 * The converter rides the utf8mb4_convert Drush extension, which needs a
 * full Drupal bootstrap and D7's global $databases — Backdrop can never
 * run it, so the task is hidden on Backdrop platforms. Core versions other
 * than Drupal 7 are left to the backend, which fail-closes; the frontend
 * stays version-agnostic because platform packages may be missing or stale.
 */
function hosting_tasks_extra_utf8mb4_convert_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  if (!isset($node->site_status) || $node->site_status != HOSTING_SITE_ENABLED) {
    return FALSE;
  }
  // Guarded so this module keeps working where hosting_backdrop is absent
  // (without it no Backdrop platform can exist in this frontend anyway).
  if (isset($node->platform) && function_exists('hosting_backdrop_platform_is_backdrop')
    && hosting_backdrop_platform_is_backdrop($node->platform)) {
    return FALSE;
  }
  // The converter is Drupal-7-shaped end to end; a foreign-CMS site either
  // has no database at all (Grav) or was created utf8mb4 from birth (TXP).
  if (hosting_tasks_extra_site_is_foreign_cms($node)) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Access callback for the updates_report task.
 *
 * Grav and Textpattern have no update report to give; Backdrop keeps the button
 * and the backend says what it can report there.
 */
function hosting_tasks_extra_updates_report_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  return !hosting_tasks_extra_site_is_foreign_cms($node);
}

