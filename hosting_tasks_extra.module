/**
 * Implements hook_form_alter().
 */
function hosting_tasks_extra_form_alter(&$form, &$form_state, $form_id) {
  // Hosting Task Forms
  if ($form_id == 'hosting_task_confirm_form') {
    switch ($form['task']['#value']) {

      case 'features_update_all':
        drupal_set_title(t('Update Features'));
        break;
      case 'features_revert_all':
        drupal_set_title(t('Revert Features'));
        break;

      case 'migrate':
        hosting_tasks_extra_drupal_upgrade_migrate_alter($form);
        break;

      case 'drupal_upgrade':
        // Here, not in the form's builder: the confirm form sets its own
        // title after the builder has run.
        if (!empty($form['nid']['#value']) && ($site = node_load($form['nid']['#value']))) {
          drupal_set_title(t('Upgrade @site', array('@site' => $site->title)));
        }
        break;

      case 'drupal_upgrade_all':
        if (!empty($form['nid']['#value']) && ($platform = node_load($form['nid']['#value']))) {
          drupal_set_title(t('Upgrade all sites on @platform', array('@platform' => $platform->title)));
        }
        // One function queues the whole run, in place of the panel's one row.
        $form['#submit'] = array('hosting_tasks_extra_drupal_upgrade_all_submit');
        break;

    }
  }
}

/**
 * Access callback for the rebuild_registry task.
 *
 * Hidden on foreign-CMS sites (Grav, Textpattern): no registry and no
 * service container exist there (the backend command also refuses honestly
 * if invoked directly). Inert where those frontend modules are absent.
 */
function hosting_tasks_extra_rebuild_registry_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  if (hosting_tasks_extra_site_is_foreign_cms($node)) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Loads what reads a tenant's tree and judges a move between two codebases.
 *
 * The backend's command file brings its own copy of the file, and may load
 * it from another tree while the panel moves to a new one: a second copy in
 * the same process would be a fatal error.
 *
 * @return bool
 *   FALSE when the copy that is loaded is too old to judge an Upgrade.
 */
function hosting_tasks_extra_upgrade_include() {
  if (!function_exists('_provision_tasks_extra_lock_diff')) {
    module_load_include('inc', 'hosting_tasks_extra', 'hosting_tasks_extra.upgrade');
  }
  return function_exists('_provision_tasks_extra_upgrade_judge') && function_exists('_provision_tasks_extra_lock_slim') && function_exists('_provision_tasks_extra_codebase_other');
}

/**
 * Access callback for the drupal_upgrade task.
 *
 * A task's own callback replaces the panel's check, which is what tests the
 * permission, view access, the panel's own site and an enabled site: so it
 * comes first. The button then shows only when a platform is ready.
 */
function hosting_tasks_extra_drupal_upgrade_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  $found = hosting_tasks_extra_drupal_upgrade_targets($node, $GLOBALS['user']);
  return !empty($found['ready']);
}

/**
 * The directory name of a site under its platform's sites folder.
 */
function hosting_tasks_extra_drupal_upgrade_site_name($site) {
  return !empty($site->hosting_name) ? ltrim($site->hosting_name, '@') : hosting_site_get_domain($site->title);
}

/**
 * One codebase's lock as the classifier reads it, kept between requests.
 *
 * Keyed by the files the reading comes from, each by its size and time, so
 * a codebase that changes is read again.
 */
function hosting_tasks_extra_drupal_upgrade_lock($root) {
  $loaded = &drupal_static(__FUNCTION__, array());
  if (isset($loaded[$root])) {
    return $loaded[$root];
  }
  $cid = '';
  $app = _provision_tasks_extra_app_root($root);
  if ($app !== '') {
    $files = array('composer.lock', 'composer.json', 'vendor/composer/installed.json', 'patches.json', 'patches.lock.json');
    $json = _provision_tasks_extra_read_plain($app . '/composer.json', 4194304);
    $named = ($json === FALSE) ? '' : _provision_tasks_extra_lock_patches_file_name(json_decode($json, TRUE));
    if ($named !== '') {
      $files[] = $named;
    }
    $signature = $app;
    foreach ($files as $file) {
      clearstatcache(TRUE, $app . '/' . $file);
      $stat = @lstat($app . '/' . $file);
      $signature .= '|' . $file . ':' . ($stat === FALSE ? '-' : $stat['size'] . ':' . $stat['mtime'] . ':' . $stat['ino']);
    }
    $cid = 'hosting_tasks_extra:upgrade_lock:2:' . hash('sha256', $signature);
    $cached = cache_get($cid, 'cache');
    if ($cached && is_array($cached->data) && $cached->expire > REQUEST_TIME) {
      $loaded[$root] = $cached->data;
      return $loaded[$root];
    }
  }
  $lock = _provision_tasks_extra_lock_slim(_provision_tasks_extra_lock_load($root));
  if ($cid !== '' && !empty($lock['ok'])) {
    cache_set($cid, $lock, 'cache', REQUEST_TIME + 86400);
  }
  $loaded[$root] = $lock;
  return $lock;
}

/**
 * The newest advisory report the panel holds for a platform's lock, or NULL.
 *
 * "Check available updates" audits a platform's whole lock, whichever of
 * its sites it ran on. A report older than thirty days, older than the lock
 * it read, or of another lock is no report.
 *
 * @return array|null
 *   'lines', 'why' and 'date'.
 */
function hosting_tasks_extra_drupal_upgrade_report($platform_nid, $root) {
  $read = &drupal_static(__FUNCTION__, array());
  $key = (int) $platform_nid . ':' . $root;
  if (!array_key_exists($key, $read)) {
    $read[$key] = _hosting_tasks_extra_drupal_upgrade_report($platform_nid, $root);
  }
  return $read[$key];
}

/**
 * Reads hosting_tasks_extra_drupal_upgrade_report() from the task logs.
 */
function _hosting_tasks_extra_drupal_upgrade_report($platform_nid, $root) {
  $app = _provision_tasks_extra_app_root($root);
  if ($app === '') {
    return NULL;
  }
  $lock = $app . '/composer.lock';
  clearstatcache(TRUE, $lock);
  $changed = @filemtime($lock);
  if ($changed === FALSE) {
    return NULL;
  }
  $rows = db_query_range("SELECT t.vid, t.executed FROM {hosting_task} t
      INNER JOIN {node} n ON n.vid = t.vid
      INNER JOIN {node} sn ON sn.nid = t.rid
      INNER JOIN {hosting_site} s ON s.vid = sn.vid
    WHERE t.task_type = :type AND t.task_status = :status AND s.platform = :platform AND t.executed > :since
    ORDER BY t.executed DESC", 0, 5, array(
      ':type' => 'updates_report',
      ':status' => HOSTING_TASK_SUCCESS,
      ':platform' => $platform_nid,
      ':since' => max(REQUEST_TIME - 30 * 86400, $changed),
    ));
  foreach ($rows as $row) {
    $read = '';
    $lines = NULL;
    $messages = db_query("SELECT message FROM {hosting_task_log} WHERE vid = :vid ORDER BY lid", array(':vid' => $row->vid));
    foreach ($messages as $entry) {
      $message = (string) $entry->message;
      $m = array();
      if (preg_match('/###---### read from (\S+): the whole platform/', $message, $m)) {
        $read = $m[1];
      }
      elseif (strncmp($message, 'advisories: ', 12) === 0) {
        $lines = explode("\n", $message);
      }
    }
    // The site may have run on another platform when it was audited.
    if ($lines !== NULL && $read === $lock) {
      return array('lines' => $lines, 'why' => '', 'date' => (int) $row->executed);
    }
  }
  return NULL;
}

/**
 * What kind of move it is between two platforms, as far as the panel can read.
 *
 * The security half comes from the newest advisory report of each platform,
 * when the panel holds one for both; else it stays unknown and the run
 * itself audits both locks.
 *
 * @return array
 *   _provision_tasks_extra_lock_classify(), and 'audited': the two reports'
 *   dates, or FALSE.
 */
function hosting_tasks_extra_drupal_upgrade_diff($source_nid, $source_root, $target_nid, $target_root) {
  $source_audit = hosting_tasks_extra_drupal_upgrade_report($source_nid, $source_root);
  $target_audit = ($source_audit === NULL) ? NULL : hosting_tasks_extra_drupal_upgrade_report($target_nid, $target_root);
  if ($target_audit === NULL) {
    $source_audit = NULL;
  }
  $diff = _provision_tasks_extra_lock_classify(
    hosting_tasks_extra_drupal_upgrade_lock($source_root),
    hosting_tasks_extra_drupal_upgrade_lock($target_root),
    $source_audit,
    $target_audit
  );
  $diff['audited'] = ($source_audit === NULL) ? FALSE : array($source_audit['date'], $target_audit['date']);
  return $diff;
}

/**
 * The condition that keeps a load over platforms to their own rows, or none.
 *
 * A profile instance's iid can equal a platform's nid, and the profile's
 * packages, its own profile among them, are recorded under that number on
 * another platform. A panel whose package module does not know the condition
 * yet would take it for a column.
 */
function hosting_tasks_extra_platform_own() {
  return function_exists('hosting_package_ref_ambiguous') ? array('platform_own' => TRUE) : array();
}

/**
 * The switched-on modules of a site as the panel holds them.
 *
 * Rows of the site itself: a profile's rows can carry the same number as a
 * site's node and never have status 1, because the platform scan they come
 * from sets none.
 *
 * @return array
 *   name => array('schema_version', 'filename').
 */
function hosting_tasks_extra_drupal_upgrade_modules($site_nid) {
  $modules = array();
  // The site's own rows: those of its platform, of none, and its own packages.
  $platforms = array(0, -1);
  $platform = (int) db_query("SELECT s.platform FROM {hosting_site} s INNER JOIN {node} n ON n.vid = s.vid WHERE n.nid = :nid", array(':nid' => $site_nid))->fetchField();
  if ($platform > 0) {
    $platforms[] = $platform;
  }
  $rows = db_query("SELECT p.short_name, i.schema_version, i.filename FROM {hosting_package_instance} i
      INNER JOIN {hosting_package} p ON p.nid = i.package_id
    WHERE i.rid = :rid AND p.package_type = :type AND i.status = 1 AND i.platform IN (:platforms)", array(':rid' => $site_nid, ':type' => 'module', ':platforms' => $platforms));
  foreach ($rows as $row) {
    $modules[$row->short_name] = array('schema_version' => $row->schema_version, 'filename' => (string) $row->filename);
  }
  return $modules;
}

/**
 * What a site has switched on that a platform's profile does not carry.
 */
function hosting_tasks_extra_drupal_upgrade_missing($site_nid, $profile_iid) {
  $current = _hosting_package_temporary_table($site_nid, 'site');
  $target = _hosting_package_temporary_table($profile_iid, 'profile');
  return db_query("SELECT c.short_name FROM $current c LEFT JOIN $target t ON c.nid = t.nid WHERE t.nid IS NULL AND c.status = 1 ORDER BY c.short_name")->fetchCol();
}

/**
 * Why a platform is another codebase than the site's: '', a reason or NULL.
 *
 * A site on a distribution's own profile is compared with the platforms that
 * carry that profile too, which is taken as enough.
 *
 * @return string|null
 *   _provision_tasks_extra_codebase_other().
 */
function hosting_tasks_extra_drupal_upgrade_other($core_profile, $modules, $source_root, $target_root) {
  if (!$core_profile) {
    return '';
  }
  return _provision_tasks_extra_codebase_other(
    hosting_tasks_extra_drupal_upgrade_lock($source_root),
    hosting_tasks_extra_drupal_upgrade_lock($target_root),
    count(_provision_tasks_extra_modules_beside_core($modules, $source_root))
  );
}

/**
 * The platforms a site can be upgraded onto, each ready or with its reason.
 *
 * One function for the button, the dialog, the form's check, the check when
 * the task starts and the site page's line. The account is an argument: the
 * task runner is uid 1, and it asks for the user who queued the task.
 *
 * @param object $site
 *   The site node.
 * @param object $account
 *   The user the question is asked for.
 * @param bool $reset
 *   TRUE to read everything again within one request.
 *
 * @return array
 *   'state': ready, none (nothing newer), not_ready (newer platforms, none
 *   of them ready), refused (the site itself cannot be upgraded), off or
 *   unreadable (a list stops every upgrade), denied. 'why' for all but ready
 *   and none. 'release' and 'platform' of the site now. 'targets': nid =>
 *   array with nid, title, release, ready, listed, why, rule, lacks, kind,
 *   pending, security and audited. 'ready': the nids that are, newest release
 *   first. 'not_ready': the listed ones that are not, as they are shown.
 */
function hosting_tasks_extra_drupal_upgrade_targets($site, $account, $reset = FALSE) {
  $found = &drupal_static(__FUNCTION__, array());
  $key = (int) $site->nid . ':' . (int) $account->uid;
  if ($reset) {
    drupal_static_reset('hosting_tasks_extra_drupal_upgrade_lock');
    drupal_static_reset('hosting_tasks_extra_drupal_upgrade_report');
    unset($found[$key]);
  }
  if (!isset($found[$key])) {
    $found[$key] = _hosting_tasks_extra_drupal_upgrade_targets($site, $account);
  }
  return $found[$key];
}

/**
 * Works out hosting_tasks_extra_drupal_upgrade_targets().
 */
function _hosting_tasks_extra_drupal_upgrade_targets($site, $account) {
  $out = array('state' => 'refused', 'why' => '', 'release' => '', 'platform' => '', 'targets' => array(), 'ready' => array(), 'not_ready' => array());
  if (!user_access('create drupal_upgrade task', $account) || !node_access('view', $site, $account)) {
    $out['state'] = 'denied';
    $out['why'] = 'this account may not upgrade this site';
    return $out;
  }
  // Rule 1: the site.
  if ($site->type != 'site' || !isset($site->site_status) || $site->site_status != HOSTING_SITE_ENABLED) {
    $out['why'] = 'this site is not enabled';
    return $out;
  }
  if ($site->nid == hosting_get_hostmaster_site_nid()) {
    $out['why'] = 'this is the control panel\'s own site';
    return $out;
  }
  if (hosting_tasks_extra_site_is_foreign_cms($site)
    || (function_exists('hosting_backdrop_platform_is_backdrop') && hosting_backdrop_platform_is_backdrop($site->platform))) {
    $out['why'] = 'the Upgrade is for Drupal 10 and later sites';
    return $out;
  }
  $platform = node_load($site->platform);
  if (!is_object($platform) || empty($platform->publish_path)) {
    $out['why'] = 'the platform of this site is not known';
    return $out;
  }
  $out['platform'] = $platform->title;
  $release = (isset($platform->release) && is_object($platform->release) && isset($platform->release->version)) ? (string) $platform->release->version : '';
  $out['release'] = $release;
  if ($release === '' || version_compare($release, '10', '<')) {
    $out['why'] = 'the Upgrade is for Drupal 10 and later sites';
    return $out;
  }
  if (!hosting_tasks_extra_upgrade_include()) {
    $out['why'] = 'the control panel is being updated; look again in a few minutes';
    return $out;
  }
  $modules = hosting_tasks_extra_drupal_upgrade_modules($site->nid);
  if (!isset($modules['system'])) {
    $out['why'] = 'Verify this site first: the panel holds no record of its modules yet';
    return $out;
  }
  // The two lists. One that is switched off or cannot be read stops every
  // upgrade, whatever the platform.
  $name = hosting_tasks_extra_drupal_upgrade_site_name($site);
  $source_root = _provision_tasks_extra_docroot($platform->publish_path);
  $platform_modes = _provision_tasks_extra_upgrade_modes($source_root . '/sites/all/modules/boa_platform_control.ini');
  $site_modes = _provision_tasks_extra_upgrade_modes($source_root . '/sites/' . $name . '/modules/boa_site_control.ini');
  foreach (array("the platform's" => $platform_modes, "this site's" => $site_modes) as $whose => $modes) {
    if ($modes['state'] === 'off' || $modes['state'] === 'unreadable') {
      $allow = _provision_tasks_extra_upgrade_modes_allow($modes, array());
      $out['state'] = $modes['state'];
      $out['why'] = _provision_tasks_extra_upgrade_list_refusal($whose, $modes, $allow);
      return $out;
    }
  }

  // The release above is the panel's record of the platform's last Verify,
  // and so are the site's module rows. Code changed in place since then (a
  // Composer update in the platform) is what the backend reads: ask for the
  // Verify that brings the record up to it.
  $changed = _provision_tasks_extra_release_changed(_provision_tasks_extra_core_release($source_root), $release);
  if ($changed !== '') {
    $out['why'] = "this site's platform " . $platform->title . ' changed since its last Verify (' . $changed . '): run Verify on that platform first';
    return $out;
  }

  // Rules 2 and 3: the platforms this account may use that carry the site's
  // install profile, as the Migrate form finds them.
  $profile = node_load($site->profile);
  // Every codebase carries core's own profiles, so they tell no two apart.
  $core_profile = !is_object($profile) || empty($profile->short_name) || in_array($profile->short_name, array('standard', 'minimal', 'testing', 'demo_umami'), TRUE);
  $own = hosting_tasks_extra_platform_own();
  $instances = hosting_package_instances_load(array('r.type' => 'platform', 'n.nid' => $site->profile, 'h.status' => HOSTING_PLATFORM_ENABLED) + $own);
  if (is_object($profile) && !empty($profile->short_name)) {
    $instances += hosting_package_instances_load(array('r.type' => 'platform', 'p.old_short_name' => $profile->short_name, 'h.status' => HOSTING_PLATFORM_ENABLED) + $own);
  }
  $allowed = ($account->uid == 1) ? NULL : _hosting_get_allowed_platforms($account->uid);
  // A platform the site was upgraded away from takes no Migrate of it back
  // (hosting_tasks_extra_drupal_upgrade_migrate_start()), whatever release it
  // carries now: the Upgrade's own move would be refused there.
  $left = hosting_tasks_extra_drupal_upgrade_left_platforms($site);
  $leftover = NULL;
  foreach ($instances as $instance) {
    $nid = (int) $instance->rid;
    if ($nid == $site->platform || isset($out['targets'][$nid])) {
      continue;
    }
    if ($allowed !== NULL && !isset($allowed[$nid])) {
      continue;
    }
    $target = node_load($nid);
    if (!is_object($target) || $target->type != 'platform' || $target->platform_status != HOSTING_PLATFORM_ENABLED || empty($target->publish_path)) {
      continue;
    }
    if ((function_exists('hosting_backdrop_platform_is_backdrop') && hosting_backdrop_platform_is_backdrop($nid))
      || (function_exists('hosting_grav_platform_is_grav') && hosting_grav_platform_is_grav($nid))
      || (function_exists('hosting_txp_platform_is_txp') && hosting_txp_platform_is_txp($nid))) {
      continue;
    }
    $entry = _hosting_tasks_extra_drupal_upgrade_target($site, $platform, $source_root, $release, $modules, $platform_modes, $site_modes, $target, $instance, $core_profile);
    // Only one that would be offered as a newer version is said to be left:
    // an older one is not shown at all.
    if ($entry['listed'] && in_array($nid, $left)) {
      $entry['ready'] = FALSE;
      $entry['pending'] = FALSE;
      $entry['why'] = 'this site was upgraded away from it, and a move back onto it is refused; a newer version is another platform';
      $entry['rule'] = 'left';
    }
    // What an earlier run left of the site refuses a new one as it starts.
    // While a task that copies or moves the site waits or runs (the one that
    // asks included), what it made is no leftover.
    if ($entry['ready']) {
      if ($leftover === NULL) {
        $leftover = (hosting_tasks_extra_drupal_upgrade_busy($site->nid) !== '') ? FALSE : hosting_tasks_extra_drupal_upgrade_leftover($site, $source_root);
      }
      $why = $leftover;
      if ($why === '') {
        $stray = _provision_tasks_extra_docroot($target->publish_path) . '/sites/' . $name;
        $why = (@file_exists($stray) || @is_link($stray)) ? 'a leftover of this site is in the way on it (its folder sites/' . $name . '): ask support' : '';
      }
      if (is_string($why) && $why !== '') {
        $entry['ready'] = FALSE;
        $entry['pending'] = FALSE;
        $entry['why'] = $why;
        $entry['rule'] = 'leftover';
      }
    }
    $out['targets'][$nid] = $entry;
  }

  // The newest release first.
  $ready = array();
  $not_ready = array();
  foreach ($out['targets'] as $nid => $entry) {
    if ($entry['ready']) {
      $ready[$nid] = $entry['release'];
    }
    elseif ($entry['listed']) {
      $not_ready[$nid] = $entry;
    }
  }
  uasort($ready, 'version_compare');
  uasort($not_ready, '_provision_tasks_extra_upgrade_not_ready_order');
  $out['not_ready'] = array_keys($not_ready);
  $out['ready'] = array_reverse(array_keys($ready));
  if ($out['ready']) {
    $out['state'] = 'ready';
  }
  elseif ($not_ready) {
    $out['state'] = 'not_ready';
    // The one shown first says most (its order is the dialog's).
    $first = reset($not_ready);
    $out['why'] = ($first['rule'] === 'leftover' && $leftover !== '') ? $first['why'] : $first['title'] . ': ' . $first['why'];
  }
  else {
    $out['state'] = 'none';
  }
  return $out;
}

/**
 * Judges one platform as a target for a site: rules 4 to 10.
 */
function _hosting_tasks_extra_drupal_upgrade_target($site, $platform, $source_root, $release, $modules, $platform_modes, $site_modes, $target, $instance, $core_profile) {
  $entry = array(
    'nid' => (int) $target->nid,
    'title' => $target->title,
    'release' => (isset($target->release) && is_object($target->release) && isset($target->release->version)) ? (string) $target->release->version : '',
    'ready' => FALSE,
    // A platform that is no newer version is not shown at all.
    'listed' => FALSE,
    'why' => '',
    // What refused it: catalogue, changed, older, codebase, a rule of the
    // judge, floor, missing, left or leftover (set by the caller).
    'rule' => '',
    // How many of the site's switched-on packages it does not carry, where
    // rule 8 was reached.
    'lacks' => 0,
    'kind' => '',
    'pending' => FALSE,
    // TRUE, FALSE, or NULL while no advisory report of both platforms is at hand.
    'security' => NULL,
    'audited' => FALSE,
  );
  $target_root = _provision_tasks_extra_docroot($target->publish_path);
  // Rule 4.
  if (_provision_tasks_extra_upgrade_is_catalogue($target_root)) {
    $entry['why'] = 'it is one of the platforms the system ships, which are no upgrade targets';
    $entry['rule'] = 'catalogue';
    return $entry;
  }
  // A platform whose code changed in place since its last Verify: the panel's
  // release and package rows are those of the code before. Shown, greyed, only
  // where its code is a newer version than the site's.
  $disk = _provision_tasks_extra_core_release($target_root);
  $changed = _provision_tasks_extra_release_changed($disk, $entry['release']);
  if ($changed !== '') {
    $entry['why'] = 'its code changed since its last Verify (' . $changed . '): run Verify on this platform first';
    $entry['rule'] = 'changed';
    $entry['listed'] = version_compare($disk, $release, '>') && (string) hosting_tasks_extra_drupal_upgrade_other($core_profile, $modules, $source_root, $target_root) === '';
    return $entry;
  }
  // Rules 5 and 6 and the release half of 7. An older release needs no lock.
  if ($entry['release'] !== '' && version_compare($entry['release'], $release, '<')) {
    $entry['why'] = 'it carries Drupal ' . $entry['release'] . ', older than the ' . $release . ' this site runs';
    $entry['rule'] = 'older';
    return $entry;
  }
  // Another codebase is no newer version of this one, whatever release it
  // carries and whatever it adds: not shown at all.
  $other = hosting_tasks_extra_drupal_upgrade_other($core_profile, $modules, $source_root, $target_root);
  if (is_string($other) && $other !== '') {
    $entry['why'] = $other;
    $entry['rule'] = 'codebase';
    return $entry;
  }
  // Where the locks cannot tell, the site's own modules do: the ones its
  // platform adds to core and this one lacks (records that cannot be
  // compared give no verdict).
  if ($other === NULL) {
    $mine = _provision_tasks_extra_modules_beside_core($modules, $source_root);
    $status = $mine ? hosting_package_comparison($site->nid, $instance->iid, 'site', 'profile') : array();
    if (!empty($status['missing']) && empty($status['ambiguous'])) {
      $gone = count(array_intersect_key($mine, array_flip(hosting_tasks_extra_drupal_upgrade_missing($site->nid, $instance->iid))));
      if (!_provision_tasks_extra_codebase_kept(count($mine), $gone)) {
        $entry['why'] = _provision_tasks_extra_codebase_text('it lacks ' . $gone . ' of the ' . count($mine) . ' modules added to core that this site has switched on');
        $entry['rule'] = 'codebase';
        return $entry;
      }
    }
  }
  $diff = hosting_tasks_extra_drupal_upgrade_diff($platform->nid, $source_root, $target->nid, $target_root);
  $newer = _provision_tasks_extra_upgrade_newer($release, $entry['release'], $diff);
  if ($newer['why'] !== '') {
    $entry['why'] = $newer['why'];
    $entry['rule'] = $newer['rule'];
    $entry['listed'] = ($newer['rule'] === 'major' || $newer['rule'] === 'floor');
    return $entry;
  }
  $entry['listed'] = TRUE;
  $diff = _provision_tasks_extra_upgrade_release_step($release, $entry['release'], $diff);
  $entry['security'] = $diff['security'];
  $entry['audited'] = $diff['audited'];
  $entry['kind'] = _provision_tasks_extra_upgrade_kind_text($diff);
  if ($diff['security'] === TRUE && is_array($diff['audited'])) {
    $entry['kind'] .= ' (advisories as read on ' . format_date($diff['audited'][0], 'custom', 'Y-m-d') . ' and ' . format_date($diff['audited'][1], 'custom', 'Y-m-d') . ')';
  }
  // What the run would refuse for a fact these same files show.
  $dead = _provision_tasks_extra_drush_cannot_start($target_root);
  if ($dead !== '') {
    $entry['why'] = "its own Drush cannot start (" . $dead . '). Rebuild the platform, or require consolidation/robo 5.1.1 in it';
    $entry['rule'] = 'drush';
    return $entry;
  }
  // Rule 7, the database half.
  $floor = _provision_tasks_extra_database_floor($modules, $source_root, $target_root);
  $too_old = _provision_tasks_extra_database_floor_text($floor, $entry['release']);
  if ($too_old !== '') {
    $entry['why'] = $too_old;
    $entry['rule'] = 'floor';
    return $entry;
  }
  // Rule 8. The comparison's count of downgrades is not used: it reads a
  // module that left core for a project of its own as one.
  $status = hosting_package_comparison($site->nid, $instance->iid, 'site', 'profile');
  if (!empty($status['ambiguous'])) {
    $entry['why'] = "the panel's package records cannot be compared: " . (isset($status['ambiguous_why']) ? $status['ambiguous_why'] : 'two of them share one number');
    $entry['rule'] = 'missing';
    return $entry;
  }
  if (!empty($status['missing'])) {
    $missing = hosting_tasks_extra_drupal_upgrade_missing($site->nid, $instance->iid);
    $entry['lacks'] = (int) $status['missing'];
    $entry['why'] = 'it lacks what this site has switched on: ' . _provision_tasks_extra_upgrade_names($missing ? $missing : array($status['missing'] . ' packages'));
    $entry['rule'] = 'missing';
    return $entry;
  }
  if (!empty($status['error'])) {
    $entry['why'] = 'the database of ' . (int) $status['error'] . ' of this site\'s modules is newer than their code there';
    $entry['rule'] = 'missing';
    return $entry;
  }
  // Rules 9 and 10. What cannot be told here is left to the run.
  $verdict = _provision_tasks_extra_upgrade_judge($release, $entry['release'], $diff, $platform_modes, $site_modes, TRUE);
  if (!$verdict['ok']) {
    $entry['why'] = $verdict['why'];
    $entry['rule'] = $verdict['rule'];
    return $entry;
  }
  $entry['pending'] = $verdict['pending'] || $diff['scope'] === 'unknown' || $diff['level'] === 'unknown' || $diff['security'] === NULL;
  $entry['ready'] = TRUE;
  return $entry;
}

/**
 * One platform as a target for a site, also one that is not offered.
 */
function hosting_tasks_extra_drupal_upgrade_target($site, $account, $target_nid, $reset = FALSE) {
  $found = hosting_tasks_extra_drupal_upgrade_targets($site, $account, $reset);
  if (isset($found['targets'][$target_nid])) {
    $entry = $found['targets'][$target_nid];
    $entry['site_why'] = '';
    return $entry;
  }
  $why = $found['why'];
  if (in_array($found['state'], array('ready', 'none', 'not_ready'), TRUE)) {
    $why = ($target_nid == $site->platform) ? 'this site already runs on that platform' : 'that platform is not one this site can be upgraded onto from this account';
  }
  return array('nid' => (int) $target_nid, 'title' => '', 'release' => '', 'ready' => FALSE, 'listed' => FALSE, 'why' => $why, 'rule' => 'site', 'lacks' => 0, 'kind' => '', 'pending' => FALSE, 'security' => NULL, 'audited' => FALSE, 'site_why' => $why);
}

/**
 * The task of a kind that is queued or running on a site, or ''.
 *
 * An Upgrade copies and moves the site: nothing else that copies, moves or
 * removes it may be waiting or under way.
 */
function hosting_tasks_extra_drupal_upgrade_busy($site_nid, $except_nid = 0) {
  $type = db_query_range("SELECT t.task_type FROM {hosting_task} t
      INNER JOIN {node} n ON n.vid = t.vid
    WHERE t.rid = :rid AND t.nid <> :except AND t.task_type IN (:types) AND t.task_status IN (:statuses)
    ORDER BY t.vid ASC", 0, 1, array(
      ':rid' => $site_nid,
      ':except' => $except_nid,
      ':types' => array('migrate', 'clone', 'restore', 'backup', 'delete', 'drupal_upgrade', 'drupal_upgrade_return'),
      ':statuses' => array(HOSTING_TASK_QUEUED, HOSTING_TASK_PROCESSING),
    ))->fetchField();
  return $type ? (string) $type : '';
}

/**
 * How long the newest finished Backup or Clone of a site took, in seconds.
 */
function hosting_tasks_extra_drupal_upgrade_copy_seconds($site_nid) {
  $delta = db_query_range("SELECT t.delta FROM {hosting_task} t
      INNER JOIN {node} n ON n.vid = t.vid
    WHERE t.rid = :rid AND t.task_type IN (:types) AND t.task_status IN (:statuses) AND t.delta > 0
    ORDER BY t.executed DESC", 0, 1, array(
      ':rid' => $site_nid,
      ':types' => array('backup', 'clone'),
      ':statuses' => array(HOSTING_TASK_SUCCESS, HOSTING_TASK_WARNING),
    ))->fetchField();
  return $delta ? (int) ceil($delta) : 0;
}

/**
 * Implements hosting_task_TASK_TYPE_form().
 */
function hosting_task_drupal_upgrade_form($node) {
  $form = array();
  $found = hosting_tasks_extra_drupal_upgrade_targets($node, $GLOBALS['user'], TRUE);
  $form['now'] = array(
    '#markup' => '<p>' . t('Now: Drupal @release on platform @platform.', array('@release' => $found['release'], '@platform' => $found['platform'])) . '</p>',
    '#weight' => -100,
  );
  // The ready platforms first, the newest release on top and chosen; then
  // the ones that are newer and not ready, each with its reason.
  $order = array_merge($found['ready'], $found['not_ready']);
  $weight = -90;
  foreach ($order as $nid) {
    $entry = $found['targets'][$nid];
    $title = check_plain($entry['title']) . ': ' . t('Drupal @release', array('@release' => $entry['release']));
    if ($entry['kind'] !== '') {
      $title .= ' — ' . check_plain($entry['kind']);
    }
    $form[$nid]['target_platform'] = array(
      '#type' => 'radio',
      '#title' => $title,
      '#parents' => array('parameters', 'target_platform'),
      '#return_value' => $nid,
      '#weight' => $weight++,
    );
    if (!$entry['ready']) {
      $form[$nid]['target_platform']['#disabled'] = TRUE;
      $form[$nid]['target_platform']['#description'] = t('Not ready: @why.', array('@why' => $entry['why']));
      continue;
    }
    if ($found['ready'][0] == $nid) {
      $form[$nid]['target_platform']['#default_value'] = $nid;
    }
    if ($entry['pending']) {
      $form[$nid]['target_platform']['#description'] = t('Security advisories, and whatever else cannot be told from here, are checked when the upgrade starts.');
    }
  }
  if (!$found['ready']) {
    $form['none'] = array(
      '#markup' => '<p><strong>' . t('No platform is ready for this site to be upgraded onto.') . '</strong>' . ($found['why'] !== '' ? ' ' . check_plain(drupal_ucfirst($found['why'])) . '.' : '') . '</p>',
      '#weight' => -95,
    );
    return $form;
  }

  $domain = check_plain($node->title);
  $platform = check_plain($found['platform']);
  $tasks = hosting_available_tasks('site');
  $steps = array(
    t('A full copy of the site as it is now (files and database) is made on !platform under a separate name, back-<em>number</em>.temp.!domain, and switched off. It is your way back.', array('!platform' => $platform, '!domain' => $domain)),
    t('The site moves onto the new platform, and Drupal\'s database updates run there. For a short time visitors see a maintenance page or a placeholder page.'),
    t('Before the old version is removed, the home page and the login page are opened and compared with how they answered before. If the updates did not finish, or a page now shows an error or is not served by this site, the upgrade stops: !domain stays on !platform, the copy from step 1 is removed, and the site\'s page cache is cleared, so it is slower for a while.', array('!platform' => $platform, '!domain' => $domain)),
    isset($tasks['drupal_upgrade_return'])
      ? t('Afterwards, look at your site. If something is wrong, press <strong>Go back</strong> on the site page.')
      : t('Afterwards, look at your site. The copy from step 1 stays, switched off, until you delete it.'),
  );
  $before = t('Choose a quiet time. If the upgrade succeeds, changes made on the site while it runs (orders, comments, edits, new logins) are not kept; if it stops, nothing is lost. It takes about as long as two backups of this site. While it runs it needs free disk space for two more copies of the site\'s files and about four of its database; afterwards the kept copy and the backup made with it use about twice the site, until you delete the copy and the backup expires.');
  $seconds = hosting_tasks_extra_drupal_upgrade_copy_seconds($node->nid);
  if ($seconds > 0) {
    $before .= ' ' . t('The last copy of this site took about @time.', array('@time' => format_interval($seconds, 2)));
  }
  $form['what'] = array(
    '#markup' => '<p><strong>' . t('What happens, in order') . '</strong></p><ol><li>' . implode('</li><li>', $steps) . '</li></ol>'
      . '<p><strong>' . t('Before you start.') . '</strong> ' . $before . '</p>',
    '#weight' => 50,
  );
  return $form;
}

/**
 * Implements hosting_task_TASK_TYPE_form_validate().
 */
function hosting_task_drupal_upgrade_form_validate($form, &$form_state) {
  $site = node_load($form_state['values']['nid']);
  $target = isset($form_state['values']['parameters']['target_platform']) ? (int) $form_state['values']['parameters']['target_platform'] : 0;
  if (!is_object($site) || $target < 1) {
    form_set_error('parameters][target_platform', t('Choose the platform to upgrade onto.'));
    return;
  }
  $entry = hosting_tasks_extra_drupal_upgrade_target($site, $GLOBALS['user'], $target, TRUE);
  if (!$entry['ready']) {
    form_set_error('parameters][target_platform', t('Not started: @why.', array('@why' => $entry['why'])));
    return;
  }
  $busy = hosting_tasks_extra_drupal_upgrade_busy($site->nid);
  if ($busy !== '') {
    form_set_error('parameters][target_platform', t('Not started: a @type task is waiting or running on this site. Start the upgrade when it has ended.', array('@type' => $busy)));
  }
}

/**
 * Implements hook_node_insert().
 */
function hosting_tasks_extra_node_insert($node) {
  hosting_tasks_extra_drupal_upgrade_step_title($node);
}

/**
 * Implements hook_node_update().
 */
function hosting_tasks_extra_node_update($node) {
  hosting_tasks_extra_drupal_upgrade_step_title($node);
}

/**
 * Names the step of an Upgrade in the title of a task row it runs.
 *
 * Such a row is made and run inside the Upgrade's own process, and every
 * save of a task rebuilds its title from its type. These hooks run after the
 * task type's own, so the title written here is the one that stays.
 */
function hosting_tasks_extra_drupal_upgrade_step_title($node) {
  if ($node->type != 'task' || empty($node->task_type) || empty($node->vid) || empty($node->rid)
    || !isset($node->task_args) || !is_array($node->task_args) || empty($node->task_args['upgrade_run'])) {
    return;
  }
  $steps = array(
    'drupal_upgrade' => array(
      'clone' => 'Upgrade step 1 of 2 (the copy)',
      'disable' => 'Upgrade step 1 of 2 (the copy switched off)',
      'migrate' => 'Upgrade step 2 of 2 (the move)',
      'delete' => 'Upgrade undone (the copy removed)',
    ),
    // A Go back renames twice and switches both sites: its rows say which
    // step they are, since the task type alone does not.
    'drupal_upgrade_return' => array(
      '1' => 'Go back step 1 of 2 (the upgraded site set aside)',
      '1b' => 'Go back step 1 of 2 (the upgraded site switched off)',
      '2a' => 'Go back step 2 of 2 (the copy switched on)',
      '2' => 'Go back step 2 of 2 (the copy put back)',
      '3' => 'Go back undone (the upgraded site put back)',
      '3b' => 'Go back undone (the upgraded site switched on)',
      '3c' => 'Go back undone (the copy switched off)',
    ),
  );
  $parent = db_query_range("SELECT task_type FROM {hosting_task} WHERE nid = :nid ORDER BY vid DESC", 0, 1, array(':nid' => (int) $node->task_args['upgrade_run']))->fetchField();
  $step = ($parent === 'drupal_upgrade_return')
    ? (isset($node->task_args['return_step']) ? (string) $node->task_args['return_step'] : '')
    : (string) $node->task_type;
  if (!$parent || !isset($steps[$parent][$step])) {
    return;
  }
  $ref = node_load($node->rid);
  if (!is_object($ref)) {
    return;
  }
  $title = $steps[$parent][$step] . ': ' . ($ref->type == 'site' ? hosting_site_canonical_url($ref) : $ref->title);
  $node->title = $title;
  db_update('node')->fields(array('title' => $title))->condition('nid', $node->nid)->execute();
  db_update('node_revision')->fields(array('title' => $title))->condition('vid', $node->vid)->execute();
}

/**
 * The Upgrades that moved a site, newest first.
 *
 * A row counts by what it did: it ran, the platform the site left is known
 * (from the row, or from where its copy is), and it ended well, or it ended
 * in error with its copy kept and its log naming no ending in which the site
 * stayed (_provision_tasks_extra_upgrade_run_moved()). A row that was
 * cancelled, refused or undone moved nothing and hides nothing, also when
 * the removal of its copy failed.
 *
 * @return array
 *   One array a run: 'task', 'date', 'source' and 'target' (platform node
 *   ids) and 'copy' (the name of its way back, '' when that site is gone).
 */
function hosting_tasks_extra_drupal_upgrade_runs($site) {
  hosting_tasks_extra_upgrade_include();
  $runs = array();
  $rows = db_query("SELECT t.nid, t.vid, t.task_status, t.executed FROM {hosting_task} t
      INNER JOIN {node} n ON n.vid = t.vid
    WHERE t.rid = :rid AND t.task_type = :type AND t.task_status IN (:statuses) AND t.executed > 0
    ORDER BY t.vid DESC", array(
      ':rid' => $site->nid,
      ':type' => 'drupal_upgrade',
      ':statuses' => array(HOSTING_TASK_SUCCESS, HOSTING_TASK_WARNING, HOSTING_TASK_ERROR),
    ));
  foreach ($rows as $row) {
    $args = db_query("SELECT name, value FROM {hosting_task_arguments} WHERE vid = :vid", array(':vid' => $row->vid))->fetchAllKeyed();
    $copy = 'back-' . $row->nid . '.temp.' . hosting_tasks_extra_drupal_upgrade_site_name($site);
    $copy_node = hosting_get_site_by_url($copy);
    // A row without the platform it left is read from where its copy was
    // made: the way back is always made on the platform the site was on.
    $source = !empty($args['source_platform']) ? (int) $args['source_platform'] : (is_object($copy_node) ? (int) $copy_node->platform : 0);
    if (empty($args['target_platform']) || !$source || $source == $args['target_platform']) {
      continue;
    }
    if ($row->task_status == HOSTING_TASK_ERROR) {
      $codes = is_object($copy_node) ? db_query("SELECT DISTINCT error FROM {hosting_task_log} WHERE vid = :vid AND type IN ('error', 'failed') AND error <> ''", array(':vid' => $row->vid))->fetchCol() : array();
      // An older copy of the shared include, loaded while the panel moves to
      // a new version, keeps the rule that came before.
      $moved = function_exists('_provision_tasks_extra_upgrade_run_moved')
        ? _provision_tasks_extra_upgrade_run_moved(TRUE, is_object($copy_node), $codes)
        : is_object($copy_node);
      if (!$moved) {
        continue;
      }
    }
    $runs[] = array(
      'task' => (int) $row->nid,
      'vid' => (int) $row->vid,
      'date' => (int) $row->executed,
      'source' => $source,
      'target' => (int) $args['target_platform'],
      'copy' => is_object($copy_node) ? $copy : '',
    );
  }
  return $runs;
}

/**
 * The newest Upgrade that moved a site, while the site is still where it
 * put it.
 *
 * @return array
 *   'platform' (the one it left, or 0), 'task' (the Upgrade's node id),
 *   'date', 'copy' (the name of the way back), 'made' (when the panel
 *   recorded that copy, or 0) and 'files' and 'database' (what the copy uses,
 *   in bytes, as its Upgrade measured them, or FALSE).
 */
function hosting_tasks_extra_drupal_upgrade_left($site) {
  $out = array('platform' => 0, 'task' => 0, 'date' => 0, 'copy' => '', 'made' => 0, 'files' => FALSE, 'database' => FALSE);
  $runs = hosting_tasks_extra_drupal_upgrade_runs($site);
  if (!$runs || $runs[0]['target'] != $site->platform) {
    return $out;
  }
  $out['platform'] = $runs[0]['source'];
  $out['task'] = $runs[0]['task'];
  $out['date'] = $runs[0]['date'];
  $out['copy'] = $runs[0]['copy'];
  if ($out['copy'] !== '') {
    $copy = hosting_get_site_by_url($out['copy']);
    $out['made'] = is_object($copy) ? (int) $copy->created : 0;
    // The row's arguments, which the end of the run wrote from its log;
    // else that log line itself.
    $args = db_query("SELECT name, value FROM {hosting_task_arguments} WHERE vid = :vid AND name IN ('copy_files', 'copy_database')", array(':vid' => $runs[0]['vid']))->fetchAllKeyed();
    if (isset($args['copy_files']) && ctype_digit((string) $args['copy_files'])) {
      $out['files'] = (float) $args['copy_files'];
    }
    if (isset($args['copy_database']) && ctype_digit((string) $args['copy_database'])) {
      $out['database'] = (float) $args['copy_database'];
    }
    $line = ($out['files'] !== FALSE || $out['database'] !== FALSE) ? FALSE : db_query_range("SELECT message FROM {hosting_task_log} WHERE vid = :vid AND message LIKE :size ORDER BY lid DESC", 0, 1, array(
      ':vid' => $runs[0]['vid'],
      ':size' => db_like('UPGRADE/1/COPY size: ') . '%',
    ))->fetchField();
    $m = array();
    if (is_string($line) && preg_match('/\bfiles ([0-9]+) bytes\b/', $line, $m)) {
      $out['files'] = (float) $m[1];
    }
    if (is_string($line) && preg_match('/\bdatabase ([0-9]+) bytes\b/', $line, $m)) {
      $out['database'] = (float) $m[1];
    }
  }
  return $out;
}

/**
 * The platforms a site must not be migrated back onto.
 *
 * Every platform an Upgrade moved the site away from, wherever the site is
 * now: a Migrate back would put the upgraded database under the older code.
 *
 * @return array
 *   Platform node ids.
 */
function hosting_tasks_extra_drupal_upgrade_left_platforms($site) {
  $left = array();
  foreach (hosting_tasks_extra_drupal_upgrade_runs($site) as $run) {
    if ($run['source'] != $site->platform) {
      $left[$run['source']] = $run['source'];
    }
  }
  return array_values($left);
}

/**
 * The way-back copies of a site that still stand on the platform it is on.
 *
 * Those the panel lists there, whichever site node their run was of (a Go
 * back gives the name to another node); those of the site's own Upgrades;
 * and those the backend named when it refused one. Each only while its folder
 * is there: the panel's web pages can look into a platform's sites folder by
 * name and cannot list it. Where they cannot even do that, those listed.
 *
 * @return array
 *   Upgrade task nid => what the backend said of its copy when it last
 *   refused another Upgrade of the site, or ''.
 */
function hosting_tasks_extra_drupal_upgrade_copies_left($site, $source_root) {
  $name = hosting_site_clean_domain(hosting_tasks_extra_drupal_upgrade_site_name($site));
  $found = array();
  $titles = db_query("SELECT n.title FROM {node} n
      INNER JOIN {hosting_site} s ON s.vid = n.vid
    WHERE n.type = :type AND n.title LIKE :like AND s.platform = :platform AND s.status <> :deleted", array(
      ':type' => 'site',
      ':like' => 'back-%.temp.' . db_like($name),
      ':platform' => (int) $site->platform,
      ':deleted' => HOSTING_SITE_DELETED,
    ))->fetchCol();
  foreach ($titles as $title) {
    $m = array();
    if (preg_match('/^back-([0-9]+)\.temp\.(.+)$/', hosting_site_clean_domain($title), $m) && $m[2] === $name && (int) $m[1] > 0) {
      $found[(int) $m[1]] = '';
    }
  }
  $sites = $source_root . '/sites';
  $look = @is_dir($sites);
  $runs = db_query("SELECT t.vid, t.nid FROM {hosting_task} t INNER JOIN {node} n ON n.vid = t.vid WHERE t.rid = :rid AND t.task_type = :type AND t.executed > 0", array(
    ':rid' => $site->nid,
    ':type' => 'drupal_upgrade',
  ))->fetchAllKeyed();
  if ($look) {
    foreach ($runs as $run) {
      $found += array((int) $run => '');
    }
  }
  if ($runs) {
    $copy = '/\bback-([0-9]+)\.temp\.' . preg_quote($name, '/') . '(?![A-Za-z0-9-]|\.[A-Za-z0-9])/';
    $unsafe = array();
    $lines = db_query("SELECT vid, error, message FROM {hosting_task_log}
      WHERE vid IN (:vids) AND (error = :code OR message LIKE :undo) AND message LIKE :copy
      ORDER BY lid", array(
        ':vids' => array_keys($runs),
        ':copy' => '%back-%.temp.' . db_like($name) . '%',
        ':code' => 'PROVISION_UPGRADE_NOT_STARTED',
        ':undo' => db_like('UPGRADE/UNDO back-') . '%' . db_like(' is left as it is: ') . '%',
      ));
    foreach ($lines as $line) {
      $m = array();
      // A row says nothing of another run's copy by naming its own.
      if (!preg_match($copy, $line->message, $m) || (int) $m[1] === (int) $runs[$line->vid] || (!$look && !isset($found[(int) $m[1]]))) {
        continue;
      }
      if ($line->error !== 'PROVISION_UPGRADE_NOT_STARTED') {
        $unsafe[$line->vid][(int) $m[1]] = TRUE;
      }
      elseif (strpos($line->message, ' could not be removed ') !== FALSE && empty($unsafe[$line->vid][(int) $m[1]])) {
        // The run tried to remove it and did not get to: the next one tries
        // again. Only a copy it must not touch is said to be in the way.
        $found[(int) $m[1]] = '';
      }
      else {
        $found[(int) $m[1]] = $line->message;
      }
    }
  }
  if ($look) {
    foreach (array_keys($found) as $run) {
      $path = $sites . '/back-' . $run . '.temp.' . $name;
      if (!@file_exists($path) && !@is_link($path)) {
        unset($found[$run]);
      }
    }
  }
  krsort($found);
  return $found;
}

/**
 * Why what an earlier Upgrade left of a site refuses a new one, or ''.
 *
 * The backend refuses by its runs' marks, which are in the account's log
 * folder, where the panel's web pages cannot look: here the same is read
 * from the panel's own rows (_provision_tasks_extra_upgrade_leftover()).
 * Only what they show is said. A copy they show nothing of is left to the
 * run, and so is one a run removes by itself.
 *
 * It never says to delete a copy: one whose making was cut off can still
 * name the site's own database, which its Delete would drop.
 */
function hosting_tasks_extra_drupal_upgrade_leftover($site, $source_root) {
  // An older copy of the shared include, loaded while the panel moves to a
  // new version, has no such rule.
  if (!function_exists('_provision_tasks_extra_upgrade_leftover')) {
    return '';
  }
  $left = '';
  foreach (hosting_tasks_extra_drupal_upgrade_copies_left($site, $source_root) as $run => $refusal) {
    $row = db_query_range("SELECT t.rid, t.task_status, t.executed FROM {hosting_task} t
        INNER JOIN {node} n ON n.vid = t.vid
      WHERE t.nid = :nid AND t.task_type = :type", 0, 1, array(':nid' => $run, ':type' => 'drupal_upgrade'))->fetchObject();
    if ($row && in_array($row->task_status, array(HOSTING_TASK_QUEUED, HOSTING_TASK_PROCESSING))) {
      // A run of another site node that had this name.
      continue;
    }
    $ran = $row && !empty($row->executed);
    // How far the run got: the newest line of its log that says so. A log is
    // purged after a time, and a run can outlive the runner that writes it;
    // the row of its move says so then.
    $last = '';
    $line = db_query_range("SELECT error, message, timestamp FROM {hosting_task_log}
      WHERE nid = :nid AND (error IN (:codes) OR message LIKE :copy OR message LIKE :move OR message LIKE :upgraded)
      ORDER BY lid DESC", 0, 1, array(
        ':nid' => $run,
        ':codes' => array('PROVISION_UPGRADE_NOT_UPGRADED', 'PROVISION_UPGRADE_UNFINISHED'),
        ':copy' => db_like('UPGRADE/1/COPY making ') . '%',
        ':move' => db_like('UPGRADE/2/MOVE ') . '%',
        ':upgraded' => db_like('UPGRADE/RESULT Upgraded') . '%',
      ))->fetchObject();
    if ($line && $line->error !== '') {
      $last = $line->error;
    }
    elseif ($line) {
      $words = array('UPGRADE/2/MOVE ' => 'move', 'UPGRADE/RESULT ' => 'upgraded');
      $start = substr($line->message, 0, 15);
      $last = isset($words[$start]) ? $words[$start] : '';
    }
    if ($last === '' && $ran && db_query_range("SELECT 1 FROM {hosting_task} t
        INNER JOIN {node} n ON n.vid = t.vid
        INNER JOIN {hosting_task_arguments} a ON a.vid = t.vid AND a.name = :name AND a.value = :run
      WHERE t.rid = :rid AND t.task_type = :type AND n.created >= :since", 0, 1, array(
        ':name' => 'upgrade_run',
        ':run' => (string) $run,
        ':rid' => $row->rid,
        ':type' => 'migrate',
        ':since' => $line ? (int) $line->timestamp : 0,
      ))->fetchField()) {
      $last = ($row->task_status == HOSTING_TASK_ERROR) ? 'move' : 'upgraded';
    }
    $what = _provision_tasks_extra_upgrade_leftover($last, $refusal, $ran, (bool) variable_get('hosting_tasks_extra_upgrade_tidy', TRUE));
    if ($what === 'cut' || $what === 'unfinished') {
      $when = $ran ? ' on ' . format_date($row->executed, 'custom', 'Y-m-d') : '';
      return 'an earlier upgrade of this site (task ' . $run . ') '
        . ($what === 'cut' ? 'was cut off' . $when . ' during its move' : 'did not finish' . $when)
        . ', and what it left needs support';
    }
    if ($what === 'left' && $left === '') {
      $left = 'an earlier upgrade left the copy back-' . $run . '.temp.' . hosting_tasks_extra_drupal_upgrade_site_name($site)
        . ' on this site\'s platform, where a new one would be refused over it: ask support';
    }
  }
  return $left;
}

/**
 * Takes the platforms an Upgrade left out of the Migrate form's targets.
 */
function hosting_tasks_extra_drupal_upgrade_migrate_alter(&$form) {
  if (empty($form['nid']['#value']) || !isset($form['parameters']) || !is_array($form['parameters'])) {
    return;
  }
  $site = node_load($form['nid']['#value']);
  if (!is_object($site) || $site->type != 'site') {
    return;
  }
  foreach (hosting_tasks_extra_drupal_upgrade_left_platforms($site) as $nid) {
    if (isset($form['parameters'][$nid])) {
      unset($form['parameters'][$nid]);
    }
  }
  // A radio that is gone can still be named in a request.
  $form['#validate'][] = 'hosting_tasks_extra_drupal_upgrade_migrate_validate';
}

/**
 * Refuses a Migrate of a site back onto a platform an Upgrade left.
 */
function hosting_tasks_extra_drupal_upgrade_migrate_validate($form, &$form_state) {
  $site = isset($form_state['values']['nid']) ? node_load($form_state['values']['nid']) : NULL;
  $target = isset($form_state['values']['parameters']['target_platform']) ? (int) $form_state['values']['parameters']['target_platform'] : 0;
  if (is_object($site) && $site->type == 'site' && $target && in_array($target, hosting_tasks_extra_drupal_upgrade_left_platforms($site))) {
    form_set_error('parameters][target_platform', t('This site was upgraded away from that platform: a Migrate back would put its upgraded database under the older code.'));
  }
}

/**
 * Whether a Go back is there for a site and an account, and which one.
 *
 * Two states. After an Upgrade: its newest run left the site on its target,
 * the site is switched on and still there, and the copy that run made is
 * recorded, on the platform the site left. After a Go back that stopped
 * midway: the node's newest run that recorded its names did not finish
 * (_provision_tasks_extra_return_offer(): read from the mark its own end left,
 * and a runner that was killed left none), and the node's name is the one
 * that run set it aside as, or the site's own name again for the Upgrade
 * that run went back from; the node may then be switched off, and the task
 * finishes that run from its record.
 *
 * It restates the panel's own task check where that one cannot be used: the
 * permission, the right to change both sites, not the panel's own site, not
 * a deleted site or one being deleted, not a leftover.
 *
 * @param object $node
 *   The site.
 * @param object $account
 *   The user the question is asked for.
 * @param int $except_nid
 *   The node id of a Go back task to leave out: the one that is asking.
 *
 * @return array
 *   'state': 'upgraded', 'resume' or '' (not offered), with 'why' for the
 *   last where there is something to say. 'domain', 'copy', 'copy_nid',
 *   'upgrade' (the Upgrade's node id), 'date', 'platform' and 'release' (of
 *   the copy), and for 'resume' the 'record' the earlier run kept.
 */
function hosting_tasks_extra_drupal_upgrade_return_state($node, $account, $except_nid = 0) {
  $out = array('state' => '', 'why' => '', 'domain' => '', 'copy' => '', 'copy_nid' => 0, 'upgrade' => 0, 'date' => 0, 'platform' => '', 'release' => '', 'record' => array());
  if (!is_object($node) || $node->type != 'site' || !is_object($account) || !isset($node->site_status)) {
    return $out;
  }
  if (!user_access('create drupal_upgrade_return task', $account) || !node_access('update', $node, $account)) {
    $out['why'] = 'this account may not use Go back on this site';
    return $out;
  }
  if ($node->nid == hosting_get_hostmaster_site_nid() || $node->site_status == HOSTING_SITE_DELETED
    || hosting_task_outstanding($node->nid, 'delete')
    || (function_exists('hosting_site_is_leftover') && hosting_site_is_leftover($node->nid))
    || hosting_tasks_extra_site_is_foreign_cms($node)) {
    return $out;
  }
  $title = hosting_site_clean_domain($node->title);
  // The rule that reads a run's end comes with the shared include; while the
  // panel moves to a new version an older copy of it may be loaded.
  if (!hosting_tasks_extra_upgrade_include() || !function_exists('_provision_tasks_extra_return_offer')) {
    $out['why'] = 'the control panel is being updated; look again in a few minutes';
    return $out;
  }

  // A run that stopped midway: the newest one that recorded its names. A
  // row counts only with the record its own start wrote (return_run): Retry
  // and Run Again copy every argument into a row that may never run.
  $row = db_query_range("SELECT t.nid, t.vid, t.task_status FROM {hosting_task} t
      INNER JOIN {node} n ON n.vid = t.vid
      INNER JOIN {hosting_task_arguments} a ON a.vid = t.vid AND a.name = :name
      INNER JOIN {hosting_task_arguments} r ON r.vid = t.vid AND r.name = :run AND r.value = CAST(t.nid AS CHAR)
    WHERE t.rid = :rid AND t.task_type = :type AND t.nid <> :except
    ORDER BY t.vid DESC", 0, 1, array(
      ':name' => 'return_aside',
      ':run' => 'return_run',
      ':rid' => $node->nid,
      ':type' => 'drupal_upgrade_return',
      ':except' => (int) $except_nid,
    ))->fetchObject();
  $offer = '';
  $record = array();
  if ($row) {
    $record = db_query("SELECT name, value FROM {hosting_task_arguments} WHERE vid = :vid AND name LIKE :prefix", array(':vid' => $row->vid, ':prefix' => db_like('return_') . '%'))->fetchAllKeyed();
    // Under its own name again, a run is finished only for the Upgrade it
    // went back from, and only one that had begun to rename: a step row of
    // its own, or a record it carried on from an earlier run (whose aside
    // name was made by another task), which only a run that renamed leaves.
    $upgrade = 0;
    $renamed = FALSE;
    if (isset($record['return_domain']) && $record['return_domain'] === $title) {
      $newest = hosting_tasks_extra_drupal_upgrade_left($node);
      $upgrade = (int) $newest['task'];
      $made = array();
      $carried = isset($record['return_aside']) && preg_match('/^upgraded-([0-9]+)\.temp\./', $record['return_aside'], $made) && (int) $made[1] !== (int) $row->nid;
      $renamed = $carried || (bool) db_query_range("SELECT 1 FROM {hosting_task_arguments} a
          INNER JOIN {hosting_task_arguments} s ON s.vid = a.vid AND s.name = :step AND s.value IN (:renames)
        WHERE a.name = :run AND a.value = :nid", 0, 1, array(
          ':step' => 'return_step',
          ':renames' => array('1', '3'),
          ':run' => 'upgrade_run',
          ':nid' => (string) $row->nid,
        ))->fetchField();
    }
    $offer = _provision_tasks_extra_return_offer($title, $record,
      in_array($row->task_status, array(HOSTING_TASK_QUEUED, HOSTING_TASK_PROCESSING)),
      $row->task_status == HOSTING_TASK_ERROR, $upgrade, $renamed);
  }
  if ($offer === 'busy' || $offer === 'done') {
    // Gone back already, or a run is still under way.
    return $out;
  }
  if ($offer === 'stuck') {
    $out['why'] = 'an earlier Go back stopped where it cannot go on by itself; ask support';
    return $out;
  }
  if ($offer === 'resume') {
    $copy = empty($record['return_copy_nid']) ? NULL : node_load($record['return_copy_nid']);
    if (empty($record['return_domain']) || empty($record['return_copy']) || !is_object($copy) || $copy->type != 'site' || $copy->site_status == HOSTING_SITE_DELETED) {
      $out['why'] = 'an earlier Go back stopped midway and the copy it was putting back is gone; ask support';
      return $out;
    }
    if (!node_access('update', $copy, $account)) {
      $out['why'] = 'this account may not use Go back on this site';
      return $out;
    }
    $platform = node_load($copy->platform);
    $out['state'] = 'resume';
    $out['domain'] = $record['return_domain'];
    $out['copy'] = $record['return_copy'];
    $out['copy_nid'] = (int) $copy->nid;
    $out['upgrade'] = isset($record['return_upgrade']) ? (int) $record['return_upgrade'] : 0;
    $out['date'] = $out['upgrade'] ? (int) db_query_range("SELECT executed FROM {hosting_task} WHERE nid = :nid ORDER BY vid DESC", 0, 1, array(':nid' => $out['upgrade']))->fetchField() : 0;
    $out['platform'] = is_object($platform) ? $platform->title : '';
    $out['release'] = (is_object($platform) && isset($platform->release) && is_object($platform->release) && isset($platform->release->version)) ? (string) $platform->release->version : '';
    $out['record'] = $record;
    return $out;
  }

  // After an Upgrade.
  if ($node->site_status != HOSTING_SITE_ENABLED) {
    return $out;
  }
  $left = hosting_tasks_extra_drupal_upgrade_left($node);
  if (!$left['task']) {
    $out['why'] = 'no upgrade of this site is there to go back from';
    return $out;
  }
  $copy = ($left['copy'] === '') ? NULL : hosting_get_site_by_url($left['copy']);
  if (!is_object($copy) || $copy->type != 'site' || hosting_site_clean_domain($copy->title) != $left['copy']) {
    $out['why'] = 'the copy the upgrade kept is gone';
    return $out;
  }
  if (!node_access('update', $copy, $account)) {
    $out['why'] = 'this account may not use Go back on this site';
    return $out;
  }
  $platform = node_load($left['platform']);
  if ($copy->platform != $left['platform'] || !is_object($platform) || $platform->type != 'platform'
    || $platform->platform_status == HOSTING_PLATFORM_DELETED || empty($platform->publish_path)) {
    $out['why'] = 'the platform the copy is on is gone';
    return $out;
  }
  // The copy is recorded once its Import ended; until then the panel does
  // not know its database.
  $import = db_query_range("SELECT t.task_status FROM {hosting_task} t
      INNER JOIN {node} n ON n.vid = t.vid
    WHERE t.rid = :rid AND t.task_type = :type
    ORDER BY t.vid DESC", 0, 1, array(':rid' => $copy->nid, ':type' => 'import'))->fetchField();
  if ($import === FALSE || !in_array($import, array(HOSTING_TASK_SUCCESS, HOSTING_TASK_WARNING))) {
    $out['why'] = 'the copy the upgrade kept is not recorded in the panel yet';
    return $out;
  }
  // Its folder, where this process can look.
  $sites = rtrim($platform->publish_path, '/') . '/sites';
  if (@is_dir($sites) && !@is_dir($sites . '/' . $left['copy'])) {
    $out['why'] = 'the folder of the copy the upgrade kept is gone';
    return $out;
  }
  $out['state'] = 'upgraded';
  $out['domain'] = hosting_tasks_extra_drupal_upgrade_site_name($node);
  $out['copy'] = $left['copy'];
  $out['copy_nid'] = (int) $copy->nid;
  $out['upgrade'] = (int) $left['task'];
  $out['date'] = (int) $left['date'];
  $out['platform'] = $platform->title;
  $out['release'] = (isset($platform->release) && is_object($platform->release) && isset($platform->release->version)) ? (string) $platform->release->version : '';
  return $out;
}

/**
 * Access callback for the drupal_upgrade_return task.
 */
function hosting_tasks_extra_drupal_upgrade_return_task_access($node, $task) {
  $state = hosting_tasks_extra_drupal_upgrade_return_state($node, $GLOBALS['user']);
  return $state['state'] !== '';
}

/**
 * Implements hosting_task_TASK_TYPE_form().
 */
function hosting_task_drupal_upgrade_return_form($node) {
  $form = array();
  $state = hosting_tasks_extra_drupal_upgrade_return_state($node, $GLOBALS['user']);
  if ($state['state'] === '') {
    $form['none'] = array(
      '#markup' => '<p><strong>' . t('Go back is not there for this site.') . '</strong>' . ($state['why'] !== '' ? ' ' . check_plain(drupal_ucfirst($state['why'])) . '.' : '') . '</p>',
    );
    return $form;
  }
  $names = array(
    '!domain' => check_plain($state['domain']),
    '@date' => $state['date'] ? format_date($state['date'], 'custom', 'Y-m-d') : t('the day of the upgrade'),
    '@time' => $state['date'] ? format_date($state['date'], 'custom', 'H:i') : t('the time of the upgrade'),
    '@platform' => $state['platform'],
    '@release' => $state['release'],
  );
  if ($state['state'] === 'resume') {
    $names['!aside'] = check_plain($state['record']['return_aside']);
    $intro = t('An earlier Go back of !domain stopped before it was done. This finishes it: the copy made on @date at @time, on @platform (Drupal @release), is put back under the name !domain. The upgraded site is not deleted: it is kept switched off as !aside, so anything added since the upgrade can still be copied from it.', $names);
  }
  else {
    $names['!aside'] = 'upgraded-<em>' . t('number') . '</em>.temp.' . check_plain($state['domain']);
    $intro = t('This puts back the copy of !domain made on @date at @time, on @platform (Drupal @release). The upgraded site is not deleted: it is kept switched off as !aside, so anything added since the upgrade can still be copied from it.', $names);
  }
  $points = array(
    t('Everything added or changed on !domain since @time on @date will not be on the live site.', $names),
    t('Everyone is logged out, editors included.'),
    t('The site is unavailable for a few minutes, and for longer on a large site: both steps copy all uploaded files once. HTTPS is switched back on by a check that runs afterwards; until then the site may answer without HTTPS.'),
    t('Afterwards the account holds two more sets of the uploaded files, set aside under static/files/.archived. They count toward your disk space until support prunes them or the server reclaims them when its disk runs short.'),
  );
  $form['what'] = array(
    '#markup' => '<p>' . $intro . '</p><ul><li>' . implode('</li><li>', $points) . '</li></ul>',
    '#weight' => -100,
  );
  return $form;
}

/**
 * Implements hosting_task_TASK_TYPE_form_validate().
 */
function hosting_task_drupal_upgrade_return_form_validate($form, &$form_state) {
  $site = node_load($form_state['values']['nid']);
  $state = hosting_tasks_extra_drupal_upgrade_return_state($site, $GLOBALS['user']);
  if ($state['state'] === '') {
    form_set_error('parameters', t('Not started: @why.', array('@why' => $state['why'] !== '' ? $state['why'] : t('there is nothing to go back to for this site'))));
    return;
  }
  foreach (array($site->nid, $state['copy_nid']) as $nid) {
    $busy = hosting_tasks_extra_drupal_upgrade_busy($nid);
    if ($busy !== '') {
      form_set_error('parameters', t('Not started: a @type task is waiting or running on @which. Start Go back when it has ended.', array('@type' => $busy, '@which' => ($nid == $site->nid) ? t('this site') : t('its copy'))));
      return;
    }
  }
}

/**
 * The Drupal release the panel holds for a platform, or ''.
 */
function hosting_tasks_extra_platform_release($platform) {
  return (is_object($platform) && isset($platform->release) && is_object($platform->release) && isset($platform->release->version)) ? (string) $platform->release->version : '';
}

/**
 * Whether a platform runs Backdrop, Grav or Textpattern.
 */
function hosting_tasks_extra_platform_is_foreign($nid) {
  return (function_exists('hosting_backdrop_platform_is_backdrop') && hosting_backdrop_platform_is_backdrop($nid))
    || (function_exists('hosting_grav_platform_is_grav') && hosting_grav_platform_is_grav($nid))
    || (function_exists('hosting_txp_platform_is_txp') && hosting_txp_platform_is_txp($nid));
}

/**
 * The parts of an Upgrade all sites token, or FALSE.
 *
 * A run's token is <platform node id>-<time it was queued>-<8 hex digits>.
 * Every row of the run carries it as its batch argument.
 */
function hosting_tasks_extra_drupal_upgrade_all_token($token) {
  $m = array();
  if (!is_string($token) || !preg_match('/^([1-9][0-9]{0,9})-([1-9][0-9]{0,10})-[0-9a-f]{8}$/', $token, $m)) {
    return FALSE;
  }
  return array('platform' => (int) $m[1], 'time' => (int) $m[2]);
}

/**
 * The column a task row's queuer is read from, for a query.
 */
function hosting_tasks_extra_queued_by_column($alias) {
  return (function_exists('_hosting_task_has_queued_by') && _hosting_task_has_queued_by()) ? $alias . '.queued_by' : "''";
}

/**
 * The last row of an Upgrade all sites run, or FALSE.
 *
 * The drupal_upgrade_all row the run queued on the token's platform at the
 * token's time.
 */
function hosting_tasks_extra_drupal_upgrade_all_rollup($token) {
  $parts = hosting_tasks_extra_drupal_upgrade_all_token($token);
  if (!$parts) {
    return FALSE;
  }
  return db_query_range("SELECT t.nid, t.vid, t.task_status, n.uid, " . hosting_tasks_extra_queued_by_column('t') . " AS queued_by, g.value AS target
      FROM {hosting_task} t
      INNER JOIN {node} n ON n.vid = t.vid
      INNER JOIN {hosting_task_arguments} a ON a.vid = t.vid AND a.name = :batch AND a.value = :token
      LEFT JOIN {hosting_task_arguments} g ON g.vid = t.vid AND g.name = :target
    WHERE t.rid = :platform AND t.task_type = :type AND n.created = :time
    ORDER BY t.nid ASC", 0, 1, array(
      ':batch' => 'batch',
      ':token' => $token,
      ':target' => 'target_platform',
      ':platform' => $parts['platform'],
      ':type' => 'drupal_upgrade_all',
      ':time' => $parts['time'],
    ))->fetchObject();
}

/**
 * The sites' rows of an Upgrade all sites run, in the run's order.
 *
 * A row of the run is a drupal_upgrade row with the run's token as its batch
 * argument, made at the token's time: the rows the run queued. A Retry or a
 * Run again of one is a new node, made later, and an ordinary Upgrade of its
 * site.
 *
 * @return array
 *   Objects with nid, vid, rid (the site), task_status, executed, uid,
 *   queued_by, target, order, platform (the site's now) and not_started (its
 *   log says it was refused at its start).
 */
function hosting_tasks_extra_drupal_upgrade_all_members($token) {
  $parts = hosting_tasks_extra_drupal_upgrade_all_token($token);
  if (!$parts) {
    return array();
  }
  $rows = db_query("SELECT t.nid, t.vid, t.rid, t.task_status, t.executed, n.uid, " . hosting_tasks_extra_queued_by_column('t') . " AS queued_by, g.value AS target, o.value AS batch_order, s.platform,
        (SELECT 1 FROM {hosting_task_log} l WHERE l.vid = t.vid AND l.message LIKE :not_started LIMIT 1) AS not_started
      FROM {node} n
      INNER JOIN {hosting_task} t ON t.vid = n.vid
      INNER JOIN {hosting_task_arguments} a ON a.vid = t.vid AND a.name = :batch AND a.value = :token
      LEFT JOIN {hosting_task_arguments} g ON g.vid = t.vid AND g.name = :target
      LEFT JOIN {hosting_task_arguments} o ON o.vid = t.vid AND o.name = :order
      LEFT JOIN {node} sn ON sn.nid = t.rid
      LEFT JOIN {hosting_site} s ON s.vid = sn.vid
    WHERE n.created = :time AND n.type = :node_type AND t.task_type = :type", array(
      ':not_started' => db_like('UPGRADE/RESULT Not started:') . '%',
      ':batch' => 'batch',
      ':token' => $token,
      ':target' => 'target_platform',
      ':order' => 'batch_order',
      ':time' => $parts['time'],
      ':node_type' => 'task',
      ':type' => 'drupal_upgrade',
    ))->fetchAll();
  // Only the rows the run's last row vouches for: a row written by hand with
  // the token and the time, by another user, is no site of the run.
  $rollup = $rows ? hosting_tasks_extra_drupal_upgrade_all_rollup($token) : FALSE;
  $members = array();
  foreach ($rows as $row) {
    if (!$rollup || (int) $row->uid !== (int) $rollup->uid || (string) $row->queued_by !== (string) $rollup->queued_by || (string) $row->target !== (string) $rollup->target) {
      continue;
    }
    $row->order = ctype_digit((string) $row->batch_order) ? (int) $row->batch_order : 0;
    $row->platform = (int) $row->platform;
    $row->not_started = !empty($row->not_started);
    $members[] = $row;
  }
  usort($members, '_hosting_tasks_extra_drupal_upgrade_all_order');
  return $members;
}

/**
 * Sorts the rows of a run by their place in it.
 */
function _hosting_tasks_extra_drupal_upgrade_all_order($a, $b) {
  if ($a->order != $b->order) {
    return ($a->order < $b->order) ? -1 : 1;
  }
  return ($a->nid < $b->nid) ? -1 : (($a->nid > $b->nid) ? 1 : 0);
}

/**
 * Whether an Upgrade's row is a site of an Upgrade all sites run.
 *
 * Its token must be one the run's last row carries, with the same author,
 * the same queuer and the same target, and that author must still hold the
 * permission.
 *
 * @return array
 *   'member': FALSE for an ordinary Upgrade. For a row of a run: 'token',
 *   'order', 'platform' (the one the run was for) and 'why', '' when the
 *   run's own last row vouches for it.
 */
function hosting_tasks_extra_drupal_upgrade_all_membership($task) {
  $out = array('member' => FALSE, 'token' => '', 'order' => 0, 'platform' => 0, 'why' => '');
  $args = (isset($task->task_args) && is_array($task->task_args)) ? $task->task_args : array();
  if (empty($args['batch'])) {
    return $out;
  }
  $parts = hosting_tasks_extra_drupal_upgrade_all_token((string) $args['batch']);
  // A row made at another time than its token's is not one the run queued.
  if (!$parts || empty($task->created) || (int) $task->created !== $parts['time']) {
    return $out;
  }
  $out['member'] = TRUE;
  $out['token'] = (string) $args['batch'];
  $out['order'] = (isset($args['batch_order']) && ctype_digit((string) $args['batch_order'])) ? (int) $args['batch_order'] : 0;
  $out['platform'] = $parts['platform'];
  $rollup = hosting_tasks_extra_drupal_upgrade_all_rollup($out['token']);
  $author = $rollup ? user_load($rollup->uid) : FALSE;
  $target = isset($args['target_platform']) ? (string) $args['target_platform'] : '';
  if (!$rollup || $out['order'] < 1 || (int) $rollup->uid !== (int) $task->uid
    || (string) $rollup->queued_by !== (isset($task->queued_by) ? (string) $task->queued_by : '')
    || (string) $rollup->target !== $target
    || !is_object($author) || !user_access('create drupal_upgrade_all task', $author)) {
    $out['why'] = 'start this from Upgrade all sites';
  }
  return $out;
}

/**
 * Why a site of a run may not start, from the run's other rows, or ''.
 *
 * Another site of the run that ended in error stops it. So does one still
 * processing: the queue runs one task at a time, so its runner is gone (the
 * queue's reaper marks it failed only later) or runs beside a holder past
 * its time. A site that still waits does not, whatever its place: the queue
 * promises no order (a queue that runs several tasks at a time, an older
 * queued task of that site saved again), and each site is checked by its
 * own Upgrade. So the run stops at its first failure in time, not in order.
 */
function hosting_tasks_extra_drupal_upgrade_all_blocked($token, $self_nid) {
  foreach (hosting_tasks_extra_drupal_upgrade_all_members($token) as $member) {
    if ((int) $member->nid === (int) $self_nid) {
      continue;
    }
    if ($member->task_status == HOSTING_TASK_ERROR || $member->task_status == HOSTING_TASK_PROCESSING) {
      return 'the upgrade of ' . hosting_tasks_extra_node_title($member->rid) . ' in the same Upgrade all sites did not finish';
    }
  }
  return '';
}

/**
 * The title of a node, or its number when it is gone.
 */
function hosting_tasks_extra_node_title($nid) {
  $title = db_query("SELECT title FROM {node} WHERE nid = :nid", array(':nid' => (int) $nid))->fetchField();
  return ($title === FALSE) ? 'node ' . (int) $nid : (string) $title;
}

/**
 * Implements hook_hosting_task_update_status().
 *
 * Stops an Upgrade all sites run at a site that ends in error: every site of
 * the run that still waits is cancelled, whatever its place in the run,
 * since the queue may take them in another order. A runner that is killed
 * writes no status, and the queue's reaper marks its row failed without this
 * hook: the next site's own start refuses then
 * (hosting_tasks_extra_drupal_upgrade_start()).
 */
function hosting_tasks_extra_hosting_task_update_status($task, $status) {
  if ($status != HOSTING_TASK_ERROR || !is_object($task) || !isset($task->task_type) || $task->task_type != 'drupal_upgrade' || empty($task->task_args['batch'])) {
    return;
  }
  $member = hosting_tasks_extra_drupal_upgrade_all_membership($task);
  if (!$member['member'] || $member['why'] !== '') {
    return;
  }
  $name = '';
  foreach (hosting_tasks_extra_drupal_upgrade_all_members($member['token']) as $other) {
    if ((int) $other->nid === (int) $task->nid || $other->task_status != HOSTING_TASK_QUEUED) {
      continue;
    }
    $node = node_load($other->nid, NULL, TRUE);
    if (is_object($node) && $node->type == 'task' && $node->task_status == HOSTING_TASK_QUEUED) {
      if ($name === '') {
        $name = hosting_tasks_extra_node_title($task->rid);
      }
      $node->task_status = HOSTING_TASK_WARNING;
      node_save($node);
      hosting_task_log($node->vid, 'warning', t('Cancelled: the upgrade of @site in the same Upgrade all sites did not finish.', array('@site' => $name)));
    }
  }
}

/**
 * What a platform's page and task list need, in one query a request.
 *
 * @return array
 *   'busy': a Delete or an Upgrade all sites waits or runs on it; 'site': it
 *   holds an enabled site other than the panel's own; 'run', 'run_status',
 *   'run_token': its newest Upgrade all sites row (0 and '' for none).
 */
function hosting_tasks_extra_drupal_upgrade_all_facts($platform_nid) {
  $facts = &drupal_static(__FUNCTION__, array());
  $nid = (int) $platform_nid;
  if (isset($facts[$nid])) {
    return $facts[$nid];
  }
  $row = db_query("SELECT
      (SELECT 1 FROM {hosting_task} t INNER JOIN {node} tn ON tn.vid = t.vid
        WHERE t.rid = :nid AND t.task_type IN (:busy) AND t.task_status IN (:open) LIMIT 1) AS busy,
      (SELECT 1 FROM {hosting_site} s INNER JOIN {node} sn ON sn.vid = s.vid
        WHERE s.platform = :nid AND s.status = :enabled AND sn.nid <> :panel LIMIT 1) AS site,
      (SELECT CONCAT_WS(' ', t.nid, t.task_status, a.value) FROM {hosting_task} t INNER JOIN {node} tn ON tn.vid = t.vid
          INNER JOIN {hosting_task_arguments} a ON a.vid = t.vid AND a.name = :batch
        WHERE t.rid = :nid AND t.task_type = :all ORDER BY t.nid DESC LIMIT 1) AS run", array(
      ':nid' => $nid,
      ':busy' => array('delete', 'drupal_upgrade_all'),
      ':open' => array(HOSTING_TASK_QUEUED, HOSTING_TASK_PROCESSING),
      ':enabled' => HOSTING_SITE_ENABLED,
      ':panel' => (int) hosting_get_hostmaster_site_nid(),
      ':batch' => 'batch',
      ':all' => 'drupal_upgrade_all',
    ))->fetchObject();
  $run = ($row && is_string($row->run)) ? explode(' ', $row->run) : array();
  $facts[$nid] = array(
    'busy' => $row && !empty($row->busy),
    'site' => $row && !empty($row->site),
    'run' => (count($run) == 3) ? (int) $run[0] : 0,
    'run_status' => (count($run) == 3) ? (int) $run[1] : 0,
    'run_token' => (count($run) == 3) ? $run[2] : '',
  );
  return $facts[$nid];
}

/**
 * Access callback for the drupal_upgrade_all task.
 *
 * It runs on every view of a platform's page, so whether a site is ready is
 * left to the dialog. A locked platform shows no button, which also keeps a
 * second run off while the first holds the lock.
 */
function hosting_tasks_extra_drupal_upgrade_all_task_access($node, $task) {
  if (!user_access('create drupal_upgrade_all task') || !is_object($node) || $node->type != 'platform'
    || !isset($node->platform_status) || $node->platform_status != HOSTING_PLATFORM_ENABLED
    || !node_access('update', $node, $GLOBALS['user'])) {
    return FALSE;
  }
  $release = hosting_tasks_extra_platform_release($node);
  if ($release === '' || version_compare($release, '10', '<') || hosting_tasks_extra_platform_is_foreign($node->nid)) {
    return FALSE;
  }
  $facts = hosting_tasks_extra_drupal_upgrade_all_facts($node->nid);
  return !$facts['busy'] && $facts['site'];
}

/**
 * Why an account cannot start an Upgrade all sites of a platform, or ''.
 *
 * Read fresh, for the dialog and for the queueing.
 */
function hosting_tasks_extra_drupal_upgrade_all_why($platform, $account) {
  if (!user_access('create drupal_upgrade_all task', $account)) {
    return 'this account may not upgrade all sites of a platform';
  }
  if (!is_object($platform) || $platform->type != 'platform' || !node_access('update', $platform, $account)) {
    return 'this account may not change this platform';
  }
  if ($platform->platform_status == HOSTING_PLATFORM_LOCKED) {
    return 'this platform is locked';
  }
  if ($platform->platform_status != HOSTING_PLATFORM_ENABLED || hosting_task_outstanding($platform->nid, 'delete')) {
    return 'this platform is not enabled';
  }
  $release = hosting_tasks_extra_platform_release($platform);
  if ($release === '' || version_compare($release, '10', '<') || hosting_tasks_extra_platform_is_foreign($platform->nid)) {
    return 'Upgrade all sites is for platforms of Drupal 10 and later';
  }
  if (hosting_task_outstanding($platform->nid, 'drupal_upgrade_all')) {
    return 'an Upgrade all sites of this platform is waiting or running';
  }
  return '';
}

/**
 * Why the panel takes no Upgrade all sites now, or ''.
 */
function hosting_tasks_extra_drupal_upgrade_all_refusal() {
  if (function_exists('hosting_panel_is_moving') && hosting_panel_is_moving()) {
    return 'the control panel is moving to its new version; start again in a few minutes';
  }
  // A standby copy of a server takes no writes of its own.
  if (db_driver() === 'mysql' && (int) db_query('SELECT @@global.read_only')->fetchField() === 1) {
    return 'this server is a standby copy, where sites are not changed';
  }
  if (variable_get('maintenance_mode', 0)) {
    return 'the control panel is in maintenance mode';
  }
  return '';
}

/**
 * Every enabled site of a platform, judged for each platform it could go onto.
 *
 * Each site against the chosen platform exactly as its own Upgrade judges it
 * (hosting_tasks_extra_drupal_upgrade_targets()), with its own two lists.
 *
 * @return array
 *   'sites': nid => title, lowest node id first (the run's order); 'hidden':
 *   how many the account cannot see; 'copy': nid => TRUE for a way-back copy;
 *   'targets': nid => array('nid', 'title', 'release', 'ready' (how many
 *   sites are), 'verdicts' => site nid => array('ready', 'text', 'why')).
 */
function hosting_tasks_extra_drupal_upgrade_all_judge($platform, $account) {
  $out = array('sites' => array(), 'hidden' => 0, 'copy' => array(), 'targets' => array());
  $nids = db_query("SELECT n.nid FROM {hosting_site} s INNER JOIN {node} n ON n.vid = s.vid
    WHERE s.platform = :platform AND s.status = :enabled AND n.nid <> :panel
    ORDER BY n.nid ASC", array(
      ':platform' => (int) $platform->nid,
      ':enabled' => HOSTING_SITE_ENABLED,
      ':panel' => (int) hosting_get_hostmaster_site_nid(),
    ))->fetchCol();
  // Read once for all the sites, fresh.
  drupal_static_reset('hosting_tasks_extra_drupal_upgrade_targets');
  drupal_static_reset('hosting_tasks_extra_drupal_upgrade_lock');
  drupal_static_reset('hosting_tasks_extra_drupal_upgrade_report');
  $sites = array();
  foreach ($nids as $nid) {
    $site = node_load($nid, NULL, TRUE);
    if (!is_object($site) || $site->type != 'site') {
      continue;
    }
    if (!node_access('view', $site, $account)) {
      $out['hidden']++;
      continue;
    }
    $sites[$nid] = $site;
    $out['sites'][$nid] = $site->title;
    if (preg_match('/^back-[0-9]+\.temp\./', hosting_site_clean_domain($site->title))) {
      $out['copy'][$nid] = TRUE;
    }
  }
  if ($out['hidden']) {
    return $out;
  }
  // The platforms that are a newer version for at least one site.
  foreach ($sites as $nid => $site) {
    if (isset($out['copy'][$nid])) {
      continue;
    }
    $found = hosting_tasks_extra_drupal_upgrade_targets($site, $account);
    foreach ($found['targets'] as $target_nid => $entry) {
      if ($entry['listed'] && !isset($out['targets'][$target_nid])) {
        $out['targets'][$target_nid] = array('nid' => (int) $target_nid, 'title' => $entry['title'], 'release' => $entry['release'], 'ready' => 0, 'verdicts' => array());
      }
    }
  }
  foreach (array_keys($out['targets']) as $target_nid) {
    foreach ($sites as $nid => $site) {
      $verdict = _hosting_tasks_extra_drupal_upgrade_all_verdict($site, $account, $target_nid, isset($out['copy'][$nid]));
      $out['targets'][$target_nid]['verdicts'][$nid] = $verdict;
      if ($verdict['ready']) {
        $out['targets'][$target_nid]['ready']++;
      }
    }
  }
  return $out;
}

/**
 * One site against one platform, as the dialog shows it.
 *
 * @return array
 *   'ready', 'text' (for the table) and 'why' (why it is left out, or '').
 */
function _hosting_tasks_extra_drupal_upgrade_all_verdict($site, $account, $target_nid, $copy) {
  if ($copy) {
    return array('ready' => FALSE, 'text' => t('A way-back copy'), 'why' => 'a way-back copy');
  }
  $found = hosting_tasks_extra_drupal_upgrade_targets($site, $account);
  if ($found['state'] === 'off' || $found['state'] === 'unreadable') {
    return array('ready' => FALSE, 'text' => t('Not allowed: @why', array('@why' => $found['why'])), 'why' => 'not allowed: ' . $found['why']);
  }
  $entry = hosting_tasks_extra_drupal_upgrade_target($site, $account, $target_nid);
  if (!$entry['ready']) {
    if (in_array($entry['rule'], array('scope', 'level', 'security'), TRUE)) {
      return array('ready' => FALSE, 'text' => t('Not allowed: @why', array('@why' => $entry['why'])), 'why' => 'not allowed: ' . $entry['why']);
    }
    return array('ready' => FALSE, 'text' => t('Not ready: @why', array('@why' => $entry['why'])), 'why' => 'not ready: ' . $entry['why']);
  }
  $busy = hosting_tasks_extra_drupal_upgrade_busy($site->nid);
  if ($busy !== '') {
    return array('ready' => FALSE, 'text' => t('Busy: a @type task is waiting or running', array('@type' => $busy)), 'why' => 'busy: a ' . $busy . ' task is waiting or running');
  }
  return array('ready' => TRUE, 'text' => ($entry['kind'] !== '') ? t('Ready — @kind', array('@kind' => $entry['kind'])) : t('Ready'), 'why' => '');
}

/**
 * Implements hosting_task_TASK_TYPE_form().
 */
function hosting_task_drupal_upgrade_all_form($node) {
  $form = array();
  $account = $GLOBALS['user'];
  $why = hosting_tasks_extra_drupal_upgrade_all_why($node, $account);
  $judged = ($why === '') ? hosting_tasks_extra_drupal_upgrade_all_judge($node, $account) : array('sites' => array(), 'hidden' => 0, 'copy' => array(), 'targets' => array());
  $count = count($judged['sites']);
  $form['now'] = array(
    '#markup' => '<p>' . t('Now: @platform, Drupal @release, @sites.', array(
      '@platform' => $node->title,
      '@release' => hosting_tasks_extra_platform_release($node),
      '@sites' => format_plural($count, '1 site', '@count sites'),
    )) . '</p>',
    '#weight' => -100,
  );
  if ($why === '' && $judged['hidden']) {
    $why = 'this platform holds sites this account cannot see';
  }
  if ($why === '' && !$judged['targets']) {
    $why = 'no newer platform these sites could be upgraded onto is in this account';
  }
  if ($why !== '') {
    $form['none'] = array(
      '#markup' => '<p><strong>' . t('Nothing can be upgraded from here.') . '</strong> ' . check_plain(drupal_ucfirst($why)) . '.</p>',
      '#weight' => -95,
    );
    return $form;
  }
  // The platform with most ready sites first, then the newest.
  $order = $judged['targets'];
  uasort($order, '_hosting_tasks_extra_drupal_upgrade_all_targets_order');
  $default = 0;
  $weight = -90;
  foreach ($order as $target_nid => $target) {
    $form[$target_nid]['target_platform'] = array(
      '#type' => 'radio',
      '#title' => t('@title: Drupal @release — @ready of @count sites ready', array(
        '@title' => $target['title'],
        '@release' => $target['release'],
        '@ready' => $target['ready'],
        '@count' => $count,
      )),
      '#parents' => array('parameters', 'target_platform'),
      '#return_value' => $target_nid,
      '#weight' => $weight++,
    );
    if (!$target['ready']) {
      $form[$target_nid]['target_platform']['#disabled'] = TRUE;
    }
    elseif (!$default) {
      $default = $target_nid;
      $form[$target_nid]['target_platform']['#default_value'] = $target_nid;
    }
    $rows = array();
    foreach ($target['verdicts'] as $site_nid => $verdict) {
      // The verdict is t()'s output, escaped already.
      $rows[] = array(check_plain($judged['sites'][$site_nid]), $verdict['text']);
    }
    $form[$target_nid]['sites'] = array(
      '#type' => 'container',
      '#weight' => $weight++,
      '#states' => array(
        'visible' => array(
          ':input[name="parameters[target_platform]"]' => array('value' => (string) $target_nid),
        ),
      ),
      'table' => array(
        '#markup' => theme('table', array(
          'header' => array(t('Site'), t('Onto @title', array('@title' => $target['title']))),
          'rows' => $rows,
        )),
      ),
    );
  }
  $platform = check_plain($node->title);
  $form['what'] = array(
    '#markup' => '<p>' . t('Sites are upgraded one at a time, each exactly like the Upgrade button on a site page. If one site does not upgrade, the sites after it are not started and stay as they are.') . '</p>'
      . '<p>' . t('!platform is locked first, so no new sites are created on it; until it is unlocked, sites still on it cannot be moved or cloned from the panel.', array('!platform' => $platform)) . '</p>'
      . '<p><strong>' . t('Do not queue a backup, copy or move of these sites while they are upgraded:') . '</strong> ' . t('a site with one waiting is not upgraded, and the sites after it are not started.') . '</p>',
    '#weight' => 50,
  );
  return $form;
}

/**
 * Orders the dialog's platforms: most ready sites first, then the newest.
 */
function _hosting_tasks_extra_drupal_upgrade_all_targets_order($a, $b) {
  if ($a['ready'] != $b['ready']) {
    return ($a['ready'] > $b['ready']) ? -1 : 1;
  }
  return -version_compare($a['release'], $b['release']);
}

/**
 * Implements hosting_task_TASK_TYPE_form_validate().
 */
function hosting_task_drupal_upgrade_all_form_validate($form, &$form_state) {
  $platform = node_load($form_state['values']['nid'], NULL, TRUE);
  $target = isset($form_state['values']['parameters']['target_platform']) ? (int) $form_state['values']['parameters']['target_platform'] : 0;
  if (!is_object($platform) || $target < 1) {
    form_set_error('parameters][target_platform', t('Choose the platform to upgrade onto.'));
    return;
  }
  $why = hosting_tasks_extra_drupal_upgrade_all_why($platform, $GLOBALS['user']);
  if ($why === '') {
    $why = hosting_tasks_extra_drupal_upgrade_all_refusal();
  }
  if ($why !== '') {
    form_set_error('parameters][target_platform', t('Not started: @why.', array('@why' => $why)));
  }
}

/**
 * Submit handler of the Upgrade all sites dialog, in place of the panel's.
 */
function hosting_tasks_extra_drupal_upgrade_all_submit($form, &$form_state) {
  $values = $form_state['values'];
  $result = hosting_tasks_extra_drupal_upgrade_all_enqueue((int) $values['nid'], (int) $values['parameters']['target_platform'], $GLOBALS['user']);
  if ($result['queued']) {
    drupal_set_message(format_plural(count($result['queued']), 'One site is queued to be upgraded.', '@count sites are queued to be upgraded, one at a time.'));
  }
  else {
    drupal_set_message(t('Nothing was queued: @why.', array('@why' => $result['why'])), 'error');
  }
  if ($result['queued'] && $result['refused']) {
    $items = array();
    foreach ($result['refused'] as $nid => $why) {
      $items[] = check_plain(hosting_tasks_extra_node_title($nid) . ': ' . $why);
    }
    drupal_set_message(t('Left out:') . theme('item_list', array('items' => $items)), 'warning');
  }
  $form_state['redirect'] = 'node/' . (int) $values['nid'];
  if (module_exists('overlay')) {
    overlay_close_dialog();
  }
}

/**
 * Queues an Upgrade all sites run: the one way in, for the dialog and any
 * other caller.
 *
 * In one transaction, under a lock of the platform: the platform is locked,
 * then one Upgrade a ready site is queued, in node id order, then the run's
 * last row on the platform. The queue sees none of them until all are
 * written, and a refusal or a fatal error leaves nothing behind.
 *
 * @param int $platform_nid
 *   The platform whose sites are upgraded.
 * @param int $target_nid
 *   The platform they go onto.
 * @param object $account
 *   The user the run is checked for: the current user, who the rows are
 *   queued by.
 *
 * @return array
 *   'queued' (site nid => task nid), 'rollup' (the last row's nid), 'refused'
 *   (site nid => why it is left out) and 'why' (why nothing was queued, or
 *   '').
 */
function hosting_tasks_extra_drupal_upgrade_all_enqueue($platform_nid, $target_nid, $account) {
  $out = array('queued' => array(), 'rollup' => 0, 'refused' => array(), 'why' => '');
  if (!is_object($account) || empty($account->uid) || (int) $account->uid !== (int) $GLOBALS['user']->uid) {
    $out['why'] = 'a run is queued only by the user it is checked for';
    return $out;
  }
  $why = hosting_tasks_extra_drupal_upgrade_all_refusal();
  if ($why !== '') {
    $out['why'] = $why;
    return $out;
  }
  $name = 'hosting_tasks_extra_upgrade_all:' . (int) $platform_nid;
  if (!lock_acquire($name, 120.0) && (lock_wait($name, 15) || !lock_acquire($name, 120.0))) {
    $out['why'] = 'another Upgrade all sites of this platform is being queued; look again in a minute';
    return $out;
  }
  $out = _hosting_tasks_extra_drupal_upgrade_all_enqueue((int) $platform_nid, (int) $target_nid, $account, $out);
  lock_release($name);
  return $out;
}

/**
 * Works out hosting_tasks_extra_drupal_upgrade_all_enqueue() under its lock.
 */
function _hosting_tasks_extra_drupal_upgrade_all_enqueue($platform_nid, $target_nid, $account, $out) {
  $platform = node_load($platform_nid, NULL, TRUE);
  $why = hosting_tasks_extra_drupal_upgrade_all_why($platform, $account);
  if ($why !== '') {
    $out['why'] = $why;
    return $out;
  }
  $judged = hosting_tasks_extra_drupal_upgrade_all_judge($platform, $account);
  if ($judged['hidden']) {
    $out['why'] = 'this platform holds sites this account cannot see';
    return $out;
  }
  if (!isset($judged['targets'][$target_nid])) {
    $out['why'] = 'that platform is no newer version for any site here';
    return $out;
  }
  $ready = array();
  $left = array();
  foreach ($judged['targets'][$target_nid]['verdicts'] as $nid => $verdict) {
    if ($verdict['ready']) {
      $ready[] = (int) $nid;
    }
    else {
      $out['refused'][$nid] = $verdict['why'];
      $left[] = (int) $nid . "\t" . str_replace(array("\t", "\n", "\r"), ' ', $verdict['why']);
    }
  }
  if (!$ready) {
    $out['why'] = 'no site here is ready for that platform';
    return $out;
  }
  $transaction = db_transaction();
  try {
    // Locked as the panel's Lock task locks it, and not by a queued Lock,
    // which the queue could run after the first site.
    $platform->platform_status = HOSTING_PLATFORM_LOCKED;
    $platform->no_verify = TRUE;
    node_save($platform);
    $token = (int) $platform->nid . '-' . REQUEST_TIME . '-' . bin2hex(drupal_random_bytes(4));
    foreach ($ready as $k => $nid) {
      $row = hosting_add_task($nid, 'drupal_upgrade', array(
        'target_platform' => $target_nid,
        'batch' => $token,
        'batch_order' => $k + 1,
      ));
      if (!is_object($row) || empty($row->nid)) {
        throw new Exception('the panel did not queue the upgrade of ' . $judged['sites'][$nid]);
      }
      $out['queued'][$nid] = (int) $row->nid;
    }
    $row = hosting_add_task($platform->nid, 'drupal_upgrade_all', array(
      'target_platform' => $target_nid,
      'batch' => $token,
      'sites' => count($ready),
      'left_out' => implode("\n", $left),
    ));
    if (!is_object($row) || empty($row->nid)) {
      throw new Exception('the panel did not queue the last step of the run');
    }
    $out['rollup'] = (int) $row->nid;
  }
  catch (Exception $e) {
    return _hosting_tasks_extra_drupal_upgrade_all_undo($transaction, $platform, $out, $e->getMessage());
  }
  // An Error left uncaught would end the transaction's object, which
  // commits what was written so far. PHP 5.6 has no such class and never
  // matches it.
  catch (Throwable $e) {
    return _hosting_tasks_extra_drupal_upgrade_all_undo($transaction, $platform, $out, $e->getMessage());
  }
  unset($transaction);
  return $out;
}

/**
 * Rolls back a run that was being queued: no lock, no row.
 */
function _hosting_tasks_extra_drupal_upgrade_all_undo($transaction, $platform, $out, $why) {
  $transaction->rollback();
  entity_get_controller('node')->resetCache(array($platform->nid));
  $out['queued'] = array();
  $out['rollup'] = 0;
  $out['why'] = $why;
  return $out;
}

/**
 * What a platform's page says about its newest Upgrade all sites run.
 *
 * @return string
 *   Markup, '' for a platform without one.
 */
function hosting_tasks_extra_drupal_upgrade_all_line($platform) {
  $facts = hosting_tasks_extra_drupal_upgrade_all_facts($platform->nid);
  $parts = ($facts['run_token'] !== '') ? hosting_tasks_extra_drupal_upgrade_all_token($facts['run_token']) : FALSE;
  if (!$facts['run'] || !$parts) {
    return '';
  }
  $counts = array('upgraded' => 0, 'running' => 0, 'waiting' => 0, 'failed' => 0, 'not started' => 0);
  $open = in_array($facts['run_status'], array(HOSTING_TASK_QUEUED, HOSTING_TASK_PROCESSING));
  foreach (hosting_tasks_extra_drupal_upgrade_all_members($facts['run_token']) as $member) {
    if ($member->task_status == HOSTING_TASK_PROCESSING) {
      $counts['running']++;
      $open = TRUE;
    }
    elseif ($member->task_status == HOSTING_TASK_QUEUED) {
      $counts['waiting']++;
      $open = TRUE;
    }
    elseif (hosting_tasks_extra_drupal_upgrade_all_row_upgraded($member)) {
      $counts['upgraded']++;
    }
    elseif ($member->task_status == HOSTING_TASK_WARNING || $member->not_started) {
      $counts['not started']++;
    }
    else {
      $counts['failed']++;
    }
  }
  $said = array();
  foreach ($counts as $what => $n) {
    if ($n || $what === 'upgraded') {
      $said[] = $n . ' ' . $what;
    }
  }
  // t()'s output, escaped already.
  if ($open) {
    return t('Upgrading all sites (started @when): @counts.', array('@when' => format_date($parts['time'], 'custom', 'j M H:i'), '@counts' => implode(', ', $said)));
  }
  $text = t('The last Upgrade all sites (@when): @counts.', array('@when' => format_date($parts['time'], 'custom', 'j M'), '@counts' => implode(', ', $said)));
  if ($platform->platform_status == HOSTING_PLATFORM_LOCKED) {
    $text .= ' ' . t('This platform stays locked.');
  }
  return $text;
}

/**
 * Whether a run's row upgraded its site, wherever the site is now.
 *
 * The rule the last row reads its sites with: a row moved its site when the
 * site's own Upgrades say so (hosting_tasks_extra_drupal_upgrade_runs()), and
 * a row that ended in error counts only while its site is on the target. A
 * site another task moved onto the target is not the run's doing.
 *
 * It runs on every view of the platform's page, so only a row that ran and
 * ended in error while its site is on the target costs a query: a row that
 * ended well moved its site; one that never ran, or was refused at its
 * start, did not; one that ran and ended with a warning passed its start,
 * which writes the platform the site left, so the site's Upgrades list it.
 */
function hosting_tasks_extra_drupal_upgrade_all_row_upgraded($member) {
  $status = (int) $member->task_status;
  if ($status === HOSTING_TASK_SUCCESS) {
    return TRUE;
  }
  if (empty($member->executed) || !empty($member->not_started)) {
    return FALSE;
  }
  if ($status === HOSTING_TASK_WARNING) {
    return TRUE;
  }
  if ($status !== HOSTING_TASK_ERROR || !$member->platform || (string) $member->platform !== (string) $member->target) {
    return FALSE;
  }
  $site = node_load($member->rid);
  if (!is_object($site) || $site->type != 'site') {
    return FALSE;
  }
  foreach (hosting_tasks_extra_drupal_upgrade_runs($site) as $run) {
    if ((int) $run['task'] === (int) $member->nid) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Implements hook_node_view().
 *
 * The "Drupal updates" line of a site page, for those who may upgrade, and
 * a platform page's line about its newest Upgrade all sites, for those who
 * may start one.
 */
function hosting_tasks_extra_node_view($node, $view_mode, $langcode) {
  if ($view_mode == 'teaser') {
    return;
  }
  if ($node->type == 'platform' && user_access('create drupal_upgrade_all task')) {
    $line = hosting_tasks_extra_drupal_upgrade_all_line($node);
    if ($line !== '') {
      $node->content['info']['drupal_upgrade_all'] = array(
        '#type' => 'item',
        '#title' => t('Upgrade all sites'),
        '#weight' => 21,
        '#markup' => $line,
      );
    }
    return;
  }
  if ($node->type != 'site' || !user_access('create drupal_upgrade task')) {
    return;
  }
  $line = hosting_tasks_extra_drupal_upgrade_line($node, $GLOBALS['user']);
  if ($line !== '') {
    $node->content['info']['drupal_updates'] = array(
      '#type' => 'item',
      '#title' => t('Drupal updates'),
      '#weight' => 21,
      '#markup' => $line,
    );
  }
}

/**
 * What the site page says about upgrades of a Drupal 10 or later site.
 *
 * @return string
 *   Markup, '' for a site the Upgrade is not for.
 */
function hosting_tasks_extra_drupal_upgrade_line($site, $account) {
  $found = hosting_tasks_extra_drupal_upgrade_targets($site, $account);
  if ($found['state'] === 'denied' || $found['release'] === '' || version_compare($found['release'], '10', '<')) {
    return '';
  }
  $lines = array();
  switch ($found['state']) {
    case 'ready':
      $entry = $found['targets'][$found['ready'][0]];
      $text = t('Upgrade available: @title, Drupal @release', array('@title' => $entry['title'], '@release' => $entry['release']));
      if ($entry['kind'] !== '') {
        $text .= ' — ' . check_plain($entry['kind']);
      }
      if (count($found['ready']) > 1) {
        $text .= ' ' . format_plural(count($found['ready']) - 1, '(and 1 more platform)', '(and @count more platforms)');
      }
      $text .= '. ' . l(t('Upgrade'), 'hosting_confirm/' . $site->nid . '/site_drupal_upgrade', array('query' => array('token' => drupal_get_token($account->uid))));
      $lines[] = $text;
      break;

    case 'none':
      // Not "up to date": the panel knows this account's platforms, not what
      // has been released since they were built.
      $lines[] = t('No newer platform this site could be upgraded onto is in this account.');
      break;

    case 'not_ready':
      $by_list = TRUE;
      foreach ($found['targets'] as $entry) {
        if ($entry['listed'] && !in_array($entry['rule'], array('scope', 'level', 'security'), TRUE)) {
          $by_list = FALSE;
        }
      }
      $lines[] = ($by_list ? t('No upgrade is accepted: @why.', array('@why' => $found['why'])) : t('Not ready: @why.', array('@why' => $found['why'])));
      break;

    case 'off':
    case 'unreadable':
      $lines[] = check_plain(drupal_ucfirst($found['why'])) . '.';
      break;

    default:
      // A site of the right kind that cannot be upgraded as it is.
      if ($found['why'] === '' || !isset($site->site_status) || $site->site_status != HOSTING_SITE_ENABLED) {
        return '';
      }
      $lines[] = t('Not ready: @why.', array('@why' => $found['why']));
  }
  $left = hosting_tasks_extra_drupal_upgrade_left($site);
  if ($left['task']) {
    $text = t('Upgraded on @date.', array('@date' => format_date($left['date'], 'custom', 'Y-m-d')));
    if ($left['copy'] !== '') {
      $text .= ' ' . hosting_tasks_extra_drupal_upgrade_copy_text($left);
      // The button, once the copy is recorded and for those who may use it.
      $back = hosting_tasks_extra_drupal_upgrade_return_state($site, $account);
      if ($back['state'] === 'upgraded') {
        $text .= ' ' . l(t('Go back'), 'hosting_confirm/' . $site->nid . '/site_drupal_upgrade_return', array('query' => array('token' => drupal_get_token($account->uid))));
      }
    }
    $lines[] = $text;
  }
  $supported = hosting_tasks_extra_drupal_upgrade_supported($found['release']);
  if ($supported !== '') {
    $lines[] = $supported;
  }
  return implode('<br />', $lines);
}

/**
 * The sentence of the site line that names the way back, its age and size.
 *
 * @param array $left
 *   hosting_tasks_extra_drupal_upgrade_left() with a copy.
 */
function hosting_tasks_extra_drupal_upgrade_copy_text($left) {
  $parts = array();
  if ($left['made'] > 0) {
    $parts[] = t('made @age ago', array('@age' => format_interval(max(60, REQUEST_TIME - $left['made']), 1)));
  }
  if ($left['files'] !== FALSE && $left['database'] !== FALSE) {
    $parts[] = t('@size on disk (files @files, database @database)', array(
      '@size' => format_size($left['files'] + $left['database']),
      '@files' => format_size($left['files']),
      '@database' => format_size($left['database']),
    ));
  }
  elseif ($left['files'] !== FALSE) {
    $parts[] = t('at least @size on disk (its database was not measured)', array('@size' => format_size($left['files'])));
  }
  elseif ($left['database'] !== FALSE) {
    $parts[] = t('at least @size on disk (its files were not measured)', array('@size' => format_size($left['database'])));
  }
  $text = t('The way back is @copy', array('@copy' => $left['copy']));
  foreach ($parts as $part) {
    $text .= ', ' . $part;
  }
  if ($left['files'] === FALSE && $left['database'] === FALSE) {
    return $text . ', ' . t('kept until you delete it; its size was not recorded.');
  }
  return $text . ', ' . t('kept until you delete it.');
}

/**
 * Whether a release line still gets security fixes, as one sentence, or ''.
 *
 * From the one line the system keeps of the supported release lines; with
 * no such file nothing is claimed.
 */
function hosting_tasks_extra_drupal_upgrade_supported($release) {
  $numbers = _provision_tasks_extra_release_numbers($release);
  $text = _provision_tasks_extra_read_plain('/data/conf/drupal-supported.txt', 4096);
  if ($numbers === FALSE || $text === FALSE) {
    return '';
  }
  $line = trim(strtok($text, "\n"));
  if (!preg_match('/^[0-9]+\.[0-9]+( [0-9]+\.[0-9]+)*$/', $line)) {
    return '';
  }
  $minor = $numbers[0] . '.' . $numbers[1];
  return in_array($minor, explode(' ', $line), TRUE)
    ? t('Drupal @minor still gets security fixes.', array('@minor' => $minor))
    : t('Drupal @minor no longer gets security fixes.', array('@minor' => $minor));
}
